{
	"cSpell.language": "en,fr",
	"cSpell.words": [
		"Aktiv",
		"aktiveo",
		"Aktiveo",
		"Authed",
		"goplan",
		"hookform",
		"iconify",
		"immer",
		"Immer",
		"languagedetector",
		"middlewares",
		"nextjs",
		"Parens",
		"pdash",
		"preprod",
		"PREPROD",
		"Roboto",
		"sublabel",
		"svgr",
		"svkit",
		"tanstack"
	],
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.codeActionsOnSave": {
		"source.fixAll": true
	},
	// "editor.formatOnSave": true, // not needed since prettier is integred as an eslint rule
	"editor.tabSize": 2,
	"editor.insertSpaces": false,
	"editor.renderWhitespace": "all",
	"editor.renderFinalNewline": "dimmed",
	"editor.trimAutoWhitespace": true,
	"material-icon-theme.files.associations": {
		".env.preprod": "tune",
		"tsconfig.nextjs.json*": "tsconfig",
		"tsconfig.react-library.json*": "tsconfig"
	},
	"vscode-color-picker.languages": [
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact",
		"postcss",
		"xml",
		"html"
	],
	"typescript.tsdk": "node_modules\\typescript\\lib"
}
