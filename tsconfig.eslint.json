{
	// extend your base config to share compilerOptions, etc
	"extends": "tsconfig/tsconfig.base.json",
	"compilerOptions": {
		// ensure that nobody can accidentally use this config for a build
		"noEmit": true
	},
	"include": [
		// whatever paths you intend to lint
		"packages/eslint-config-custom-base",
		"packages/eslint-config-custom-common-react",
		"packages/eslint-config-custom-nextjs",
		"packages/eslint-config-custom-react",
		"packages/eslint-config-custom-server",

		"packages/ui-react/.eslintrc.js",

		"apps/office/.eslintrc.js",
		"apps/front/.eslintrc.js",
		"apps/awsm/.eslintrc.js",
		"apps/server/.eslintrc.js",

		"apps/front/next.config.js",

		"apps/server/esbuild",
		"apps/server/rspack.config.js",
		"apps/office/rspack.config.js",

		"./.eslintrc.js",
		"./knip.config.js",

		"./scripts/**/*.js"
	]
}
