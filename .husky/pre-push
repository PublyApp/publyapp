#!/usr/bin/env sh
# Block pushes that TARGET a protected branch, regardless of which branch is
# currently checked out. git feeds each ref being pushed on stdin as:
#   <local ref> <local sha> <remote ref> <remote sha>
# Exact full-ref comparison (refs/heads/main) is intentional: it avoids
# partial matches against branches like "refs/heads/maintain", and it covers
# deletions (git push origin :main) and force-pushes because git still reports
# the same remote_ref value for those operations.

# Verify the tracked hooks are executable in THIS worktree. A worktree left
# on a pre-#1907 commit checks out `.husky/pre-commit` at mode 100644, and
# git silently ignores a non-executable hook — the guard would then be
# inert while the author believes it is active (issue #1933). We run the
# check at the top of pre-push so a stale worktree refuses to push unformatted
# code rather than letting it leave the worktree unnoticed. The verify
# script returns 1 with the cause and the exact `chmod +x` repair command
# — `return`, not `exit`, because the script is sourced. We propagate the
# return code into a hard `exit 1` so git records a failed push.
. "$(dirname "$0")/_verify-hooks.sh"
verify_rc=$?
if [ "$verify_rc" -ne 0 ]; then
	exit "$verify_rc"
fi

protected="refs/heads/main refs/heads/develop"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	for branch in $protected; do
		if [ "$remote_ref" = "$branch" ]; then
			echo "Direct push to ${branch#refs/heads/} is not allowed, please create a new branch then open a pull request" >&2
			exit 1
		fi
	done
done

# Explicit exit 0: prevents a non-zero exit from the while-read loop itself
# (e.g. when stdin closes unexpectedly) from being mistaken for a hook failure.
exit 0
