#!/usr/bin/env sh
# makes sure fnm will make npx work
# eval "$(fnm env --use-on-cd)"

# Runs lint-staged (which auto-formats staged files) on every commit in every
# worktree. This file is TRACKED: git resolves core.hooksPath to this .husky
# directory (wired by packages/scripts-ts/src/install-git-hooks.ts via the root
# `prepare` script), so a freshly created worktree gets the same hook without
# any manual step. If lint-staged cannot run, fail LOUD — a commit must never
# slip through unformatted in silence (issue #1852).

# Verify the tracked hooks are executable in THIS worktree. A worktree left
# on a pre-#1907 commit checks out `.husky/pre-commit` at mode 100644, and
# git silently ignores a non-executable hook — the pre-commit guard would
# then be inert while the author believes it is active (issue #1933). Run
# this BEFORE lint-staged so a stale worktree refuses to keep working
# rather than producing a false sense of safety. The verify script exits 1
# on its own with the cause and the exact `chmod +x` repair command.
. "$(dirname "$0")/_verify-hooks.sh"

# Cross-platform solution that works in both terminal and VS Code/Cursor.
# Try pnpm first, then fallback to other package managers.
run_lint_staged() {
    if [ -x "$HOME/.local/share/pnpm/pnpm" ]; then
        "$HOME/.local/share/pnpm/pnpm" exec lint-staged
    elif [ -x "/usr/local/bin/pnpm" ]; then
        "/usr/local/bin/pnpm" exec lint-staged
    elif [ -x "/opt/homebrew/bin/pnpm" ]; then
        "/opt/homebrew/bin/pnpm" exec lint-staged
    elif command -v pnpm >/dev/null 2>&1; then
        pnpm exec lint-staged
    elif command -v bun >/dev/null 2>&1; then
        bun exec lint-staged
    elif command -v npx >/dev/null 2>&1; then
        npx lint-staged
    else
        echo "❌ Neither pnpm, nor npx found. Please install pnpm, or npm." >&2
        return 127
    fi
    return $?
}

if ! run_lint_staged; then
    echo "❌ lint-staged failed — staged files were not formatted." >&2
    echo "   If lint-staged is not installed in this worktree, run 'pnpm install' here, then commit again." >&2
    exit 1
fi