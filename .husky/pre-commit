# Cross-platform solution that works in both terminal and VS Code/Cursor
# Try multiple paths for bun, then fallback to npx

# Try to find bun in common locations
if [ -x "$HOME/.bun/bin/bun" ]; then
    "$HOME/.bun/bin/bun" run lint-staged
elif [ -x "/usr/local/bin/bun" ]; then
    "/usr/local/bin/bun" run lint-staged
elif [ -x "/opt/homebrew/bin/bun" ]; then
    "/opt/homebrew/bin/bun" run lint-staged
elif command -v bun >/dev/null 2>&1; then
    bun run lint-staged
elif command -v npx >/dev/null 2>&1; then
    npx lint-staged
else
    echo "Error: Neither bun nor npx found. Please install bun or npm."
    exit 1
fi
