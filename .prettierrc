{
	"arrowParens": "always",
	"bracketSameLine": false,
	"semi": true,
	"trailingComma": "all",
	"singleQuote": true,
	"printWidth": 120,
	"bracketSpacing": true,
	"endOfLine": "lf",
	"useTabs": true,
	"tabWidth": 2,

	"plugins": ["prettier-plugin-svelte"],
	"pluginSearchDirs": ["."],
	"overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }]
}
