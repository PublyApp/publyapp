<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Aspire.AppHost.Sdk (NOT the deprecated workload) is what makes this an
       Aspire host; without it NETSDK1228 fires on any .NET 10 SDK. -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

  <!-- Issue #255 spike: LOCAL DEV ORCHESTRATION ONLY. This project must never be
       referenced by apps/api, never ship in a release image, and never appear in
       dokploy.yml or docker-compose.test.yml. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>publyapp-apphost-255-spike</UserSecretsId>
    <!-- Issue #255 spike runs through plain `dotnet run`; the optional Aspire CLI
         bundle adds nothing we use. Pinning false + silencing ASPIRE010 keeps
         TreatWarningsAsErrors deterministic on every machine. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <ProjectReference Include="..\api\PublyApp.Api.csproj" />
  </ItemGroup>

</Project>
