{
	"extends": "../../packages/_tsconfig/tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"target": "ES2022",
		"types": ["vite/client", "node"],
		// @org/* workspace packages ship raw .ts and their exports maps point at
		// .ts files — allow importing them with bundler resolution.
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		// The scaffold's generated/example code is not unused-var clean; keep these
		// off for the throwaway spike (the base turns them on).
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"server.mjs",
		"scripts/**/*.mjs",
		// @org/shared-ts ships AMBIENT GLOBAL types (ValueOf/ToPrimitive/…) in its
		// @types dir; because we transpile its raw .ts via ssr.noExternal we must
		// also see those globals to typecheck it (mirrors the current `front`).
		"../../packages/shared-ts/@types/**/*.d.ts"
	],
	"exclude": ["node_modules", "dist", ".output"]
}
