{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"@/*": ["./src/*"],
			"@org/shared-ts/*": ["../../packages/shared-ts/src/*"]
		}
	},
	"include": [
		"../../packages/shared-ts/src/@types/*.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"*.d.ts",
		"tailwind.config.ts"
	]
}
