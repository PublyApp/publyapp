{
	"extends": "../../packages/_tsconfig/tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node"]
	},
	// Dedicated tsconfig for the deployment-time request-counter scripts and the
	// drawer guard temp-dir helper (#1760, #2306). The guard
	// `scripts/guards/check-typecheck-coverage.ts` asserts all four files stay
	// in this config's program.
	"include": [
		"deploy/request-counter/control-routes.ts",
		"deploy/request-counter/control-routes.test.ts",
		"deploy/request-counter/server.ts",
		"src/components/ui/drawer-guard-tmp-dir.ts"
	],
	"exclude": ["node_modules", "dist", ".output"]
}
