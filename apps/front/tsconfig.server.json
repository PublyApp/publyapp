{
	"extends": "../../packages/_tsconfig/tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node"]
	},
	// Dedicated tsconfig for the PRODUCTION entry `server.ts` and its
	// `trust-proxy.ts` sibling (#1758, #2306). Node 24 runs them directly
	// (type stripping), so they are plain TypeScript. The one import that points
	// into the build, `./dist/server/server.js`, is aliased through the
	// `#server-build` package-imports entry: the `types` condition resolves to
	// `types/server-build.d.ts`, the `default` condition is what Node uses.
	//
	// The guard `scripts/guards/check-typecheck-coverage.ts` asserts this
	// config really attends both files (it replays `tsc --listFiles`).
	"include": ["server.ts", "trust-proxy.ts"],
	"exclude": ["node_modules", "dist", ".output"]
}
