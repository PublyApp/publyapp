{
	"extends": "../../packages/_tsconfig/tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"target": "ES2022",
		"types": ["vite/client", "node"],
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"**/*.mts",
		// `server.ts`, `trust-proxy.ts` and `deploy/request-counter/*.ts` are in
		// this program through `**/*.ts` since #2306 (no `allowJs` needed).
		"scripts/**/*.mts",
		"tools/**/*.mts",
		"../../packages/shared-ts/src/@types/**/*.d.ts"
	],
	"exclude": ["node_modules", "dist", ".output"]
}
