{
	"name": "front",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#server-build": {
			"types": "./types/server-build.d.ts",
			"default": "./dist/server/server.js"
		}
	},
	"scripts": {
		"preinstall": "node scripts/run-guarded.mts scripts/guards/assert-pinned.mts",
		"dev": "vite dev",
		"generate:route-tree": "node scripts/run-guarded.mts scripts/generate/route-tree-generator.mts",
		"check:route-tree": "node scripts/run-guarded.mts scripts/generate/check-route-tree-freshness.mts",
		"build": "vite build && node scripts/run-guarded.mts scripts/guards/verify-build-css-link.mts",
		"verify:build": "node scripts/run-guarded.mts scripts/guards/verify-build-css-link.mts && node scripts/run-guarded.mts scripts/guards/verify-font-bundle.mts",
		"verify:fonts": "node scripts/run-guarded.mts scripts/guards/verify-font-bundle.mts",
		"start": "node server.mjs",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.js-surfaces.json && node scripts/run-guarded.mts scripts/guards/check-typecheck-coverage.mts",
		"test:request-counter": "node scripts/run-guarded.mts --test deploy/request-counter/control-routes.test.mjs",
		"test:e2e-compose-env": "node scripts/run-guarded.mts --test scripts/e2e-compose-env.test.mts scripts/run-e2e-front.signal.test.mts scripts/run-e2e-front.launch.test.mts",
		"test:route-tree-guard": "node scripts/run-guarded.mts --test scripts/generate/check-route-tree-freshness.test.mts scripts/generate/route-tree-generator.test.mts && pnpm check:route-tree",
		"test:search-cancel-css": "node scripts/run-guarded.mts --test scripts/guards/search-cancel-css-policy.test.mts && node scripts/run-guarded.mts scripts/guards/check-search-cancel-css.mts",
		"test:context-chunk-isolation": "node scripts/run-guarded.mts --test tools/vite/check-context-chunk-isolation.test.mts",
		"test:font-bundle": "node scripts/run-guarded.mts --test scripts/guards/verify-font-bundle.test.mts",
		"check:design-system": "node scripts/run-guarded.mts scripts/guards/check-design-system.mts",
		"check:zindex": "node scripts/run-guarded.mts scripts/guards/check-zindex-guard.mts",
		"check:react-compiler": "node scripts/run-guarded.mts scripts/guards/check-react-compiler.mts",
		"check:shared-ts-import-paths": "node scripts/run-guarded.mts scripts/guards/check-shared-ts-import-paths.mts",
		"check:shared-ts-node-resolution": "node scripts/run-guarded.mts scripts/guards/check-shared-ts-node-resolution.mts",
		"check:e2e-shared-constants": "node scripts/run-guarded.mts scripts/guards/check-e2e-shared-constants.mts",
		"check:column-type-imports": "node scripts/run-guarded.mts scripts/guards/check-column-type-imports.mts",
		"test:design-system-guard": "node scripts/run-guarded.mts --test scripts/guards/check-design-system.test.mts",
		"test:drawer-contrast": "node scripts/run-guarded.mts -- vitest run --config vitest.drawer.config.ts",
		"test:zindex-guard": "node scripts/run-guarded.mts --test scripts/guards/check-zindex-guard.test.mts",
		"test:preuves": "node scripts/run-guarded.mts scripts/ci/run-proofs.mts",
		"test:react-compiler-guard": "node scripts/run-guarded.mts --test scripts/guards/check-react-compiler.test.mts",
		"test:shared-ts-import-paths": "node scripts/run-guarded.mts --test scripts/guards/check-shared-ts-import-paths.test.mts",
		"test:shared-ts-node-resolution": "node scripts/run-guarded.mts --test scripts/guards/check-shared-ts-node-resolution.test.mts",
		"test:e2e-shared-constants-guard": "node scripts/run-guarded.mts --test scripts/guards/check-e2e-shared-constants.test.mts",
		"test:column-type-imports-guard": "node scripts/run-guarded.mts --test scripts/guards/check-column-type-imports.test.mts",
		"test:server-static-imports-guard": "node scripts/run-guarded.mts --test scripts/guards/check-server-static-imports.test.mts",
		"check:server-static-imports": "node scripts/run-guarded.mts scripts/guards/check-server-static-imports.mts",
		"smoke:start": "node scripts/run-guarded.mts scripts/ci/smoke-start-server.mts",
		"check:front-runtime-image": "node scripts/run-guarded.mts scripts/ci/check-front-runtime-image.mts",
		"test:runtime-env-startup": "node scripts/run-guarded.mts --test scripts/ci/validate-runtime-env-startup.test.mts",
		"test:vitest-shard-coverage": "GUARD_TIMEOUT_SECONDS=600 node scripts/run-guarded.mts --test scripts/ci/vitest-shard-coverage.test.mts",
		"test:front-runtime-image-guard": "node scripts/run-guarded.mts --test scripts/ci/check-front-runtime-image.test.mts",
		"test:e2e:tag": "node scripts/run-guarded.mts -- playwright test --grep",
		"test:design-guards": "node scripts/run-guarded.mts -- vitest run --config vitest.design-guards.config.ts",
		"test:ci-non-vitest": "pnpm check:guard-coverage && node scripts/run-guarded.mts --test scripts/ci/compose-startup.test.mts && pnpm test:e2e-compose-env && pnpm test:route-tree-guard && pnpm test:design-guards && pnpm test:request-counter && pnpm test:search-cancel-css && pnpm test:context-chunk-isolation && pnpm test:design-system-guard && pnpm test:zindex-guard && pnpm test:react-compiler-guard && pnpm test:shared-ts-import-paths && pnpm test:e2e-shared-constants-guard && pnpm test:column-type-imports-guard && pnpm test:server-static-imports-guard && pnpm test:font-bundle && pnpm test:shared-ts-node-resolution && pnpm check:design-system && pnpm check:zindex && pnpm check:react-compiler && pnpm check:shared-ts-import-paths && pnpm check:shared-ts-node-resolution && pnpm check:e2e-shared-constants && pnpm test:typecheck-coverage-guard && pnpm test:guard-coverage-guard && pnpm check:column-type-imports && pnpm check:server-static-imports && pnpm test:runtime-env-startup && pnpm test:front-runtime-image-guard",
		"test": "pnpm test:ci-non-vitest && vitest run",
		"test:typecheck-coverage-guard": "node scripts/run-guarded.mts --test scripts/guards/check-typecheck-coverage.test.mts",
		"check:guard-coverage": "node scripts/run-guarded.mts scripts/guards/check-guard-coverage.mts",
		"test:guard-coverage-guard": "node scripts/run-guarded.mts --test scripts/guards/check-guard-coverage.test.mts"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"@hookform/resolvers": "5.9.1",
		"@microsoft/kiota-abstractions": "1.0.0-preview.106",
		"@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.103",
		"@org/client-ts": "workspace:*",
		"@org/shared-ts": "workspace:*",
		"@tabler/icons-react": "3.46.0",
		"@tanstack/react-query": "5.102.3",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-router-ssr-query": "1.167.1",
		"@tanstack/react-start": "1.168.49",
		"@tanstack/react-table": "9.1.2",
		"@tanstack/virtual-file-routes": "1.162.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"fflate": "0.8.3",
		"i18next": "26.4.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.86.0",
		"react-i18next": "17.0.12",
		"simplebar-core": "1.3.2",
		"sonner": "2.0.8",
		"srvx": "0.12.7",
		"tailwind-merge": "3.6.0",
		"tw-animate-css": "1.4.0",
		"zod": "4.4.3",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@microsoft/kiota-serialization-json": "1.0.0-preview.103",
		"@playwright/test": "1.62.1",
		"@tailwindcss/node": "4.3.3",
		"@tailwindcss/oxide": "4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.6",
		"@types/node": "24.13.3",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.0",
		"esbuild": "0.28.1",
		"jsdom": "30.0.1",
		"oxc-transform-react": "0.147.0",
		"postcss": "8.5.26",
		"shadcn": "4.19.0",
		"tailwindcss": "4.3.3",
		"ts-morph": "28.0.0",
		"typescript": "7.0.2",
		"vite": "8.2.2",
		"vitest": "4.1.11"
	}
}
