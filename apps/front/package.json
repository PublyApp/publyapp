{
	"name": "front",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"preinstall": "node scripts/assert-pinned.mjs",
		"dev": "vite dev",
		"build": "vite build && node scripts/verify-build-css-link.mjs",
		"verify:build": "node scripts/verify-build-css-link.mjs && node scripts/verify-font-bundle.mjs",
		"verify:fonts": "node scripts/verify-font-bundle.mjs",
		"start": "node server.mjs",
		"typecheck": "tsc --noEmit",
		"test:request-counter": "node --test deploy/request-counter/control-routes.test.mjs",
		"test:search-cancel-css": "node --test scripts/search-cancel-css-policy.test.mjs && node scripts/check-search-cancel-css.mjs",
		"test:context-chunk-isolation": "node --test scripts/check-context-chunk-isolation.test.mjs",
		"test:font-bundle": "node --test scripts/verify-font-bundle.test.mjs",
		"check:design-system": "node scripts/check-design-system.mjs",
		"check:zindex": "node scripts/check-zindex-guard.mjs",
		"test:design-system-guard": "node --test scripts/check-design-system.test.mjs",
		"test:drawer-contrast": "vitest run --config vitest.drawer.config.ts",
		"test:zindex-guard": "node --test scripts/check-zindex-guard.test.mjs",
		"smoke:start": "node scripts/smoke-start-server.mjs",
		"test:e2e:tag": "playwright test --grep",
		"test": "node --test scripts/compose-startup.test.mjs && vitest run && pnpm test:request-counter && pnpm test:search-cancel-css && pnpm test:context-chunk-isolation && pnpm test:design-system-guard && pnpm test:zindex-guard && pnpm test:font-bundle && pnpm check:design-system && pnpm check:zindex"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"@hookform/resolvers": "4.1.3",
		"@microsoft/kiota-abstractions": "1.0.0-preview.102",
		"@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.102",
		"@org/client-ts": "workspace:*",
		"@org/shared-ts": "workspace:*",
		"@tabler/icons-react": "3.46.0",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-router": "1.170.31",
		"@tanstack/react-router-ssr-query": "1.167.1",
		"@tanstack/react-start": "1.168.48",
		"@tanstack/react-table": "8.20.6",
		"@tanstack/virtual-file-routes": "1.162.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"i18next": "25.4.2",
		"lodash": "4.18.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.85.0",
		"react-i18next": "15.7.4",
		"sonner": "2.0.8",
		"srvx": "0.12.5",
		"tailwind-merge": "3.6.0",
		"tw-animate-css": "1.4.0",
		"zod": "3.24.4",
		"zustand": "4.5.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.62.1",
		"@tailwindcss/node": "4.3.3",
		"@tailwindcss/oxide": "4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.5",
		"@types/node": "22.19.21",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.0.5",
		"jsdom": "30.0.1",
		"postcss": "8.5.26",
		"shadcn": "4.19.0",
		"tailwindcss": "4.3.3",
		"ts-morph": "28.0.0",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.11"
	}
}
