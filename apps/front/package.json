{
	"name": "front",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"preinstall": "node scripts/guards/assert-pinned.mts",
		"dev": "vite dev",
		"generate:route-tree": "node scripts/generate/route-tree-generator.mts",
		"check:route-tree": "node scripts/generate/check-route-tree-freshness.mts",
		"build": "vite build && node scripts/guards/verify-build-css-link.mts",
		"verify:build": "node scripts/guards/verify-build-css-link.mts && node scripts/guards/verify-font-bundle.mts",
		"verify:fonts": "node scripts/guards/verify-font-bundle.mts",
		"start": "node server.mjs",
		"typecheck": "tsc --noEmit",
		"test:request-counter": "node --test deploy/request-counter/control-routes.test.mjs",
		"test:route-tree-guard": "node --test scripts/generate/check-route-tree-freshness.test.mts scripts/generate/route-tree-generator.test.mts && pnpm check:route-tree",
		"test:search-cancel-css": "node --test scripts/guards/search-cancel-css-policy.test.mts && node scripts/guards/check-search-cancel-css.mts",
		"test:context-chunk-isolation": "node --test tools/vite/check-context-chunk-isolation.test.mts",
		"test:font-bundle": "node --test scripts/guards/verify-font-bundle.test.mts",
		"check:design-system": "node scripts/guards/check-design-system.mts",
		"check:zindex": "node scripts/guards/check-zindex-guard.mts",
		"check:react-compiler": "node scripts/guards/check-react-compiler.mts",
		"check:shared-ts-import-paths": "node scripts/guards/check-shared-ts-import-paths.mts",
		"test:design-system-guard": "node --test scripts/guards/check-design-system.test.mts",
		"test:drawer-contrast": "vitest run --config vitest.drawer.config.ts",
		"test:zindex-guard": "node --test scripts/guards/check-zindex-guard.test.mts",
		"test:preuves": "node scripts/ci/run-preuves.mts",
		"test:react-compiler-guard": "node --test scripts/guards/check-react-compiler.test.mts",
		"test:shared-ts-import-paths": "node --test scripts/guards/check-shared-ts-import-paths.test.mts",
		"smoke:start": "node scripts/ci/smoke-start-server.mts",
		"test:e2e:tag": "playwright test --grep",
		"test:design-guards": "vitest run --config vitest.design-guards.config.ts",
		"test": "node --test scripts/ci/compose-startup.test.mts && pnpm test:route-tree-guard && vitest run && pnpm test:design-guards && pnpm test:request-counter && pnpm test:search-cancel-css && pnpm test:context-chunk-isolation && pnpm test:design-system-guard && pnpm test:zindex-guard && pnpm test:react-compiler-guard && pnpm test:shared-ts-import-paths && pnpm test:font-bundle && pnpm check:design-system && pnpm check:zindex && pnpm check:react-compiler && pnpm check:shared-ts-import-paths"
	},
	"dependencies": {
		"@base-ui/react": "1.7.0",
		"@hookform/resolvers": "5.9.1",
		"@microsoft/kiota-abstractions": "1.0.0-preview.103",
		"@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.103",
		"@org/client-ts": "workspace:*",
		"@org/shared-ts": "workspace:*",
		"@tabler/icons-react": "3.46.0",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-router": "1.170.31",
		"@tanstack/react-router-ssr-query": "1.167.1",
		"@tanstack/react-start": "1.168.48",
		"@tanstack/react-table": "8.20.6",
		"@tanstack/virtual-file-routes": "1.162.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"i18next": "26.3.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.85.0",
		"react-i18next": "17.0.12",
		"simplebar-core": "1.3.2",
		"sonner": "2.0.8",
		"srvx": "0.11.16",
		"tailwind-merge": "3.6.0",
		"tw-animate-css": "1.4.0",
		"zod": "4.4.3",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@microsoft/kiota-serialization-json": "1.0.0-preview.103",
		"@playwright/test": "1.62.1",
		"@tailwindcss/node": "4.3.3",
		"@tailwindcss/oxide": "4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/dom": "10.4.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.5",
		"@types/node": "22.19.21",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "6.1.0",
		"jsdom": "30.0.1",
		"oxc-transform-react": "0.145.0",
		"postcss": "8.5.26",
		"shadcn": "4.19.0",
		"tailwindcss": "4.3.3",
		"ts-morph": "28.0.0",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.11"
	}
}
