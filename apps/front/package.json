{
	"name": "front",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"imports": {
		"#server-build": {
			"types": "./types/server-build.d.ts",
			"default": "./dist/server/server.js"
		}
	},
	"scripts": {
		"preinstall": "node scripts/run-guarded.ts scripts/guards/assert-pinned.ts",
		"dev": "vite dev",
		"generate:route-tree": "node scripts/run-guarded.ts scripts/generate/route-tree-generator.ts",
		"check:route-tree": "node scripts/run-guarded.ts scripts/generate/check-route-tree-freshness.ts",
		"build": "vite build && node scripts/run-guarded.ts scripts/guards/verify-build-css-link.ts",
		"verify:build": "node scripts/run-guarded.ts scripts/guards/verify-build-css-link.ts && node scripts/run-guarded.ts scripts/guards/verify-font-bundle.ts",
		"verify:fonts": "node scripts/run-guarded.ts scripts/guards/verify-font-bundle.ts",
		"start": "node server.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.js-surfaces.json && node scripts/run-guarded.ts scripts/guards/check-typecheck-coverage.ts",
		"test:request-counter": "node scripts/run-guarded.ts --test deploy/request-counter/control-routes.test.ts",
		"test:e2e-compose-env": "node scripts/run-guarded.ts --test scripts/e2e-compose-env.test.ts scripts/run-e2e-front.signal.test.ts scripts/run-e2e-front.launch.test.ts scripts/run-proof-child.test.ts",
		"test:route-tree-guard": "node scripts/run-guarded.ts --test scripts/generate/check-route-tree-freshness.test.ts scripts/generate/route-tree-generator.test.ts && pnpm check:route-tree",
		"test:search-cancel-css": "node scripts/run-guarded.ts --test scripts/guards/search-cancel-css-policy.test.ts && node scripts/run-guarded.ts scripts/guards/check-search-cancel-css.ts",
		"test:context-chunk-isolation": "node scripts/run-guarded.ts --test tools/vite/check-context-chunk-isolation.test.ts",
		"test:simplebar-upstream-css": "node scripts/run-guarded.ts --test tools/vite/transform-simplebar-upstream-css.test.ts",
		"test:font-bundle": "node scripts/run-guarded.ts --test scripts/guards/verify-font-bundle.test.ts",
		"check:design-system": "node scripts/run-guarded.ts scripts/guards/check-design-system.ts",
		"check:zindex": "node scripts/run-guarded.ts scripts/guards/check-zindex-guard.ts",
		"check:react-compiler": "node scripts/run-guarded.ts scripts/guards/check-react-compiler.ts",
		"check:shared-ts-import-paths": "node scripts/run-guarded.ts scripts/guards/check-shared-ts-import-paths.ts",
		"check:shared-ts-node-resolution": "node scripts/run-guarded.ts scripts/guards/check-shared-ts-node-resolution.ts",
		"check:e2e-shared-constants": "node scripts/run-guarded.ts scripts/guards/check-e2e-shared-constants.ts",
		"check:column-type-imports": "node scripts/run-guarded.ts scripts/guards/check-column-type-imports.ts",
		"check:utility-boundaries": "node scripts/run-guarded.ts scripts/guards/check-utility-boundaries.ts",
		"test:design-system-guard": "node scripts/run-guarded.ts --test scripts/guards/check-design-system.test.ts",
		"test:drawer-contrast": "node scripts/run-guarded.ts -- vitest run --config vitest.drawer.config.ts",
		"test:zindex-guard": "node scripts/run-guarded.ts --test scripts/guards/check-zindex-guard.test.ts",
		"test:preuves": "node scripts/run-guarded.ts scripts/ci/run-proofs.ts",
		"test:react-compiler-guard": "node scripts/run-guarded.ts --test scripts/guards/check-react-compiler.test.ts",
		"test:shared-ts-import-paths": "node scripts/run-guarded.ts --test scripts/guards/check-shared-ts-import-paths.test.ts",
		"test:shared-ts-node-resolution": "node scripts/run-guarded.ts --test scripts/guards/check-shared-ts-node-resolution.test.ts",
		"test:e2e-shared-constants-guard": "node scripts/run-guarded.ts --test scripts/guards/check-e2e-shared-constants.test.ts",
		"test:column-type-imports-guard": "node scripts/run-guarded.ts --test scripts/guards/check-column-type-imports.test.ts",
		"test:utility-boundaries": "node scripts/run-guarded.ts --test scripts/guards/check-utility-boundaries.test.ts",
		"test:server-static-imports-guard": "node scripts/run-guarded.ts --test scripts/guards/check-server-static-imports.test.ts",
		"check:server-static-imports": "node scripts/run-guarded.ts scripts/guards/check-server-static-imports.ts",
		"smoke:start": "node scripts/run-guarded.ts scripts/ci/smoke-start-server.ts",
		"check:front-runtime-image": "node scripts/run-guarded.ts scripts/ci/check-front-runtime-image.ts",
		"test:runtime-env-startup": "node scripts/run-guarded.ts --test scripts/ci/validate-runtime-env-startup.test.ts",
		"test:vitest-shard-coverage": "GUARD_TIMEOUT_SECONDS=600 node scripts/run-guarded.ts --test scripts/ci/vitest-shard-coverage.test.ts",
		"test:front-runtime-image-guard": "node scripts/run-guarded.ts --test scripts/ci/check-front-runtime-image.test.ts",
		"test:e2e:tag": "node scripts/run-guarded.ts -- playwright test --grep",
		"test:design-guards": "node scripts/run-guarded.ts -- vitest run --config vitest.design-guards.config.ts",
		"test:ci-non-vitest": "node scripts/run-guarded.ts scripts/ci/run-non-vitest-report-all.ts",
		"test": "pnpm test:ci-non-vitest && vitest run",
		"test:typecheck-coverage-guard": "node scripts/run-guarded.ts --test scripts/guards/check-typecheck-coverage.test.ts",
		"check:guard-coverage": "node scripts/run-guarded.ts scripts/guards/check-guard-coverage.ts",
		"test:guard-coverage-guard": "node scripts/run-guarded.ts --test scripts/guards/check-guard-coverage.test.ts"
	},
	"ciNonVitestCommandInventory": [
		[
			"pnpm",
			"check:guard-coverage"
		],
		[
			"node",
			"scripts/run-guarded.ts",
			"--test",
			"scripts/ci/compose-startup.test.ts"
		],
		[
			"pnpm",
			"test:e2e-compose-env"
		],
		[
			"pnpm",
			"test:route-tree-guard"
		],
		[
			"pnpm",
			"test:design-guards"
		],
		[
			"pnpm",
			"test:request-counter"
		],
		[
			"pnpm",
			"test:search-cancel-css"
		],
		[
			"pnpm",
			"test:context-chunk-isolation"
		],
		[
			"pnpm",
			"test:simplebar-upstream-css"
		],
		[
			"pnpm",
			"test:design-system-guard"
		],
		[
			"pnpm",
			"test:zindex-guard"
		],
		[
			"pnpm",
			"test:react-compiler-guard"
		],
		[
			"pnpm",
			"test:shared-ts-import-paths"
		],
		[
			"pnpm",
			"test:e2e-shared-constants-guard"
		],
		[
			"pnpm",
			"test:column-type-imports-guard"
		],
		[
			"pnpm",
			"test:server-static-imports-guard"
		],
		[
			"pnpm",
			"test:utility-boundaries"
		],
		[
			"pnpm",
			"check:utility-boundaries"
		],
		[
			"pnpm",
			"test:font-bundle"
		],
		[
			"pnpm",
			"test:shared-ts-node-resolution"
		],
		[
			"pnpm",
			"check:design-system"
		],
		[
			"pnpm",
			"check:zindex"
		],
		[
			"pnpm",
			"check:react-compiler"
		],
		[
			"pnpm",
			"check:shared-ts-import-paths"
		],
		[
			"pnpm",
			"check:shared-ts-node-resolution"
		],
		[
			"pnpm",
			"check:e2e-shared-constants"
		],
		[
			"pnpm",
			"test:typecheck-coverage-guard"
		],
		[
			"pnpm",
			"test:guard-coverage-guard"
		],
		[
			"pnpm",
			"check:column-type-imports"
		],
		[
			"pnpm",
			"check:server-static-imports"
		],
		[
			"pnpm",
			"test:runtime-env-startup"
		],
		[
			"pnpm",
			"test:front-runtime-image-guard"
		]
	],
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@hookform/resolvers": "6.0.0",
		"@microsoft/kiota-abstractions": "1.0.0-preview.111",
		"@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.111",
		"@org/client-ts": "workspace:*",
		"@org/shared-ts": "workspace:*",
		"@tabler/icons-react": "3.50.0",
		"@tanstack/react-query": "5.105.1",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-router-ssr-query": "1.167.3",
		"@tanstack/react-start": "1.169.4",
		"@tanstack/react-table": "9.3.1",
		"@tanstack/virtual-file-routes": "1.162.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"fflate": "0.8.3",
