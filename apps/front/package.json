{
	"name": "front",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"preinstall": "node scripts/assert-pinned.mjs",
		"dev": "vite dev",
		"generate:route-tree": "node scripts/route-tree-generator.mjs",
		"check:route-tree": "node scripts/check-route-tree-freshness.mjs",
		"build": "vite build && node scripts/verify-build-css-link.mjs",
		"verify:build": "node scripts/verify-build-css-link.mjs && node scripts/verify-font-bundle.mjs",
		"verify:fonts": "node scripts/verify-font-bundle.mjs",
		"start": "node server.mjs",
		"typecheck": "tsc --noEmit",
		"test:request-counter": "node --test deploy/request-counter/control-routes.test.mjs",
		"test:route-tree-guard": "node --test scripts/check-route-tree-freshness.test.mjs scripts/route-tree-generator.test.mjs && pnpm check:route-tree",
		"test:search-cancel-css": "node --test scripts/search-cancel-css-policy.test.mjs && node scripts/check-search-cancel-css.mjs",
		"test:context-chunk-isolation": "node --test scripts/check-context-chunk-isolation.test.mjs",
		"test:font-bundle": "node --test scripts/verify-font-bundle.test.mjs",
		"check:design-system": "node scripts/check-design-system.mjs",
		"check:zindex": "node scripts/check-zindex-guard.mjs",
		"check:react-compiler": "node scripts/check-react-compiler.mjs",
		"test:design-system-guard": "node --test scripts/check-design-system.test.mjs",
		"test:drawer-contrast": "vitest run --config vitest.drawer.config.ts",
		"test:zindex-guard": "node --test scripts/check-zindex-guard.test.mjs",
		"test:react-compiler-guard": "node --test scripts/check-react-compiler.test.mjs",
		"smoke:start": "node scripts/smoke-start-server.mjs",
		"test:e2e:tag": "playwright test --grep",
		"test": "node --test scripts/compose-startup.test.mjs && pnpm test:route-tree-guard && vitest run && pnpm test:request-counter && pnpm test:search-cancel-css && pnpm test:context-chunk-isolation && pnpm test:design-system-guard && pnpm test:zindex-guard && pnpm test:react-compiler-guard && pnpm test:font-bundle && pnpm check:design-system && pnpm check:zindex && pnpm check:react-compiler"
	},
	"dependencies": {
		"@base-ui/react": "1.3.0",
		"@hookform/resolvers": "5.9.1",
		"@microsoft/kiota-abstractions": "1.0.0-preview.103",
		"@microsoft/kiota-http-fetchlibrary": "1.0.0-preview.103",
		"@org/client-ts": "workspace:*",
		"@org/shared-ts": "workspace:*",
		"@tabler/icons-react": "3.41.1",
		"@tanstack/react-query": "5.101.0",
		"@tanstack/react-router": "1.170.16",
		"@tanstack/react-router-ssr-query": "1.167.1",
		"@tanstack/react-start": "1.168.26",
		"@tanstack/react-table": "8.20.6",
		"@tanstack/virtual-file-routes": "1.162.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"i18next": "26.3.6",
		"lodash": "4.18.1",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hook-form": "7.54.2",
		"react-i18next": "17.0.12",
		"sonner": "2.0.6",
		"srvx": "0.11.16",
		"tailwind-merge": "3.5.0",
		"tw-animate-css": "1.4.0",
		"zod": "3.24.4",
		"zustand": "4.5.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.11.3",
		"@playwright/test": "1.61.0",
		"@tailwindcss/node": "4.3.1",
		"@tailwindcss/oxide": "4.3.1",
		"@tailwindcss/vite": "4.3.1",
		"@testing-library/dom": "10.4.0",
		"@testing-library/react": "16.3.0",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "22.19.21",
		"@types/react": "19.1.8",
		"@types/react-dom": "19.1.3",
		"@vitejs/plugin-react": "6.1.0",
		"jsdom": "30.0.1",
		"oxc-transform-react": "0.145.0",
		"postcss": "8.5.25",
		"shadcn": "4.19.0",
		"tailwindcss": "4.3.1",
		"ts-morph": "28.0.0",
		"typescript": "7.0.2",
		"vite": "8.1.5",
		"vitest": "4.1.9"
	}
}
