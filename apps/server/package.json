{
	"name": "server",
	"version": "0.0.0",
	"scripts": {
		"// =============== BUILD COMMANDS =================": "================================",
		"build": "bun run build:prod",
		"build:local": "cross-env MODE=local bun run build:common",
		"build:prod": "cross-env MODE=production bun run build:common",
		"build:preprod": "cross-env MODE=preprod bun run build:common",
		"build:common": "bun run build:bun",
		"build:bun": "bun scripts/bun/build.mjs",
		"build:rs": "bun scripts/rsbuild/build.mjs",
		"// =============== START COMMANDs =================": "================================",
		"start": "bun run start:prod",
		"start:test-online": "cross-env TEST_ONLINE=true MODE=local NODE_ENV=production bun run start:common",
		"start:local": "cross-env MODE=local NODE_ENV=production bun run start:common",
		"start:prod": "cross-env MODE=production NODE_ENV=production bun run start:common",
		"start:preprod": "cross-env MODE=preprod NODE_ENV=production bun run start:common",
		"start:common": "bun --enable-source-maps dist/index.mjs",
		"// =============== DEV COMMANDS =================": "================================",
		"dev": "bun run dev:local",
		"dev:local": "cross-env MODE=local bun run dev:common",
		"dev:prod": "cross-env MODE=production bun run dev:common",
		"dev:preprod": "cross-env MODE=preprod bun run dev:common",
		"dev:common": "bun run dev:bun",
		"dev:bun": "bun scripts/bun/watch.mjs",
		"dev:rs": "bun scripts/rsbuild/watch.mjs",
		"// =============== SEED COMMANDS =================": "================================",
		"seed": "bun --enable-source-maps dist/seed.mjs",
		"seed:debug": "bun --enable-source-maps --inspect-brk dist/seed.mjs",
		"// =============== TEST COMMANDS =================": "================================",
		"postinstall": "bun scripts/patch.mjs",
		"type-check": "tsc"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.812.0",
		"@faker-js/faker": "^8.3.1",
		"@org/shared": "workspace:*",
		"@parse/fs-files-adapter": "^2.0.1",
		"@react-router/express": "^7.5.2",
		"async": "^3.2.5",
		"axios": "^1.6.5",
		"bentocache": "1.2.2",
		"body-parser": "^2.2.0",
		"chalk": "^5.3.0",
		"cloudinary": "^2.6.1",
		"cors": "^2.8.5",
		"cross-env": "^7.0.3",
		"datauri": "^4.1.0",
		"dayjs": "^1.11.10",
		"dotenv": "^16.3.1",
		"dotenv-expand": "^12.0.2",
		"esbuild-register": "^3.5.0",
		"express": "^5.1.0",
		"express-rate-limit": "^7.5.0",
		"front": "workspace:*",
		"glob": "^10.3.12",
		"helmet": "^8.0.0",
		"i18n-node": "^2.1.5",
		"i18next": "^24.2.2",
		"i18next-fs-backend": "^2.3.1",
		"image-size": "^1.1.1",
		"lodash": "^4.17.21",
		"mongodb": "^5.9.0",
		"mongoose": "^8.0.4",
		"multer": "1.4.5-lts.1",
		"nanoid": "^5.0.4",
		"numeral": "^2.0.6",
		"parse": "6.0.0",
		"parse-dashboard": "7.0.0",
		"parse-server": "8.0.0",
		"posthog-node": "^4.17.1",
		"qs": "^6.11.2",
		"sharp": "^0.33.3",
		"streamifier": "^0.1.1",
		"vhost": "^3.0.2",
		"winston": "^3.11.0",
		"winston-console-format": "^1.0.8",
		"winston-daily-rotate-file": "^5.0.0",
		"winston-transport-browserconsole": "^1.0.5",
		"zod": "^3.22.4",
		"zod-i18n-map": "^2.27.0",
		"unique-username-generator": "^1.4.0"
	},
	"devDependencies": {
		"@types/bun": "^1.2.12",
		"@rsbuild/core": "^1.3.18",
		"@rsbuild/plugin-type-check": "^1.2.1",
		"@types/async": "^3.2.24",
		"@types/body-parser": "^1.19.5",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/lodash": "^4.14.202",
		"@types/multer": "^1.4.11",
		"@types/numeral": "^2.0.5",
		"@types/parse": "^3.0.9",
		"@types/qs": "^6.9.11",
		"@types/streamifier": "^0.1.2",
		"chokidar": "^4.0.1",
		"concurrently": "^8.2.2",
		"esbuild": "^0.19.11",
		"esbuild-node-externals": "^1.12.0",
		"line-replace": "^2.0.1",
		"ms": "^2.1.3",
		"nodemon": "^3.1.4",
		"replace-in-file": "^7.1.0",
		"supertest": "^6.3.4",
		"ts-node": "^10.9.2",
		"tsconfig": "workspace:*",
		"typescript": "^5.8.3"
	},
	"engines": {
		"node": ">=20.12.2"
	}
}
