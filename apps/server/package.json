{
	"name": "server",
	"version": "0.0.0",
	"scripts": {
		"build": "tsc && pnpm run build:pack:prod",
		"build:pack:prod": "cross-env APP_ENV=production pnpm run build:pack",
		"build:pack:preprod": "cross-env APP_ENV=preprod pnpm run build:pack",
		"build:pack": "rspack",
		"build:esbuild": "tsc && concurrently \"node esbuild/build.js\" \"node esbuild/build.cloud.js\"",
		"start": "node --enable-source-maps dist/index.js",
		"dev": "pnpm run dev:pack",
		"dev:pack": "npx concurrently \"rspack --watch\" \"npx nodemon\"",
		"dev:esbuild": "npx concurrently \"node esbuild/watch.js\" \"node esbuild/watch.cloud.js\" \"npx nodemon\"",
		"lint": "eslint . --ext ts,js",
		"lint:fix": "pnpm run lint --fix",
		"seed": "pnpm run seed:pack",
		"seed:pack": "node --enable-source-maps dist/seeding/seed.js",
		"seed:esbuild": "node esbuild/build.seed.js && node --enable-source-maps -r ./esbuild/defineParse.js dist/seeding/seed.js"
	},
	"dependencies": {
		"@devist/shared": "workspace:*",
		"@faker-js/faker": "^8.2.0",
		"@parse/fs-files-adapter": "^2.0.1",
		"cloudinary": "^1.41.0",
		"cors": "^2.8.5",
		"cross-env": "^7.0.3",
		"datauri": "^4.1.0",
		"dotenv": "^16.3.1",
		"dotenv-expand": "^10.0.0",
		"esbuild-register": "^3.5.0",
		"express": "^4.18.2",
		"i18n-node": "^2.1.5",
		"i18next": "^22.5.1",
		"i18next-fs-backend": "^2.2.0",
		"image-size": "^1.0.2",
		"lodash": "^4.17.21",
		"mongodb": "^6.2.0",
		"mongoose": "^7.6.4",
		"multer": "1.4.5-lts.1",
		"nanoid": "^3.3.6",
		"parse": "^4.2.0",
		"parse-dashboard": "^5.2.0",
		"parse-server": "^6.3.1",
		"qs": "^6.11.2",
		"sharp": "^0.32.6",
		"typescript": "^5.2.2",
		"vhost": "^3.0.2",
		"winston": "^3.11.0",
		"winston-console-format": "^1.0.8",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@rspack/cli": "^0.3.10",
		"@types/cors": "^2.8.15",
		"@types/express": "^4.17.20",
		"@types/lodash": "^4.14.200",
		"@types/multer": "^1.4.9",
		"@types/parse": "^3.0.6",
		"@types/qs": "^6.9.9",
		"concurrently": "^8.2.2",
		"esbuild": "^0.17.19",
		"esbuild-node-externals": "^1.9.0",
		"eslint": "^8.52.0",
		"eslint-config-custom-server": "workspace:*",
		"nodemon": "^2.0.22",
		"ts-node": "^10.9.1",
		"tsconfig": "workspace:*"
	}
}
