{
	"name": "server",
	"version": "0.0.0",
	"scripts": {
		"build": "tsc && concurrently \"node esbuild/build.js\" \"node esbuild/build.cloud.js\"",
		"start": "node --enable-source-maps dist/index.js",
		"dev": "npx concurrently \"node esbuild/watch.js\" \"node esbuild/watch.cloud.js\" \"npx nodemon\"",
		"lint": "eslint . --ext ts,js",
		"lint:fix": "pnpm run lint --fix"
	},
	"dependencies": {
		"@aktiveo/shared": "workspace:*",
		"cors": "^2.8.5",
		"dotenv": "^16.0.3",
		"dotenv-expand": "^10.0.0",
		"express": "^4.18.2",
		"i18n-node": "^2.1.5",
		"i18next": "^22.5.1",
		"i18next-fs-backend": "^2.1.5",
		"parse": "^4.1.0",
		"parse-dashboard": "^5.1.0",
		"parse-server": "^6.1.0",
		"typescript": "^5.0.4"
	},
	"devDependencies": {
		"@faker-js/faker": "^8.0.2",
		"@types/cors": "^2.8.13",
		"@types/express": "^4.17.17",
		"@types/parse": "^3.0.4",
		"concurrently": "^8.0.1",
		"esbuild": "^0.17.19",
		"esbuild-node-externals": "^1.7.0",
		"eslint": "^8.40.0",
		"eslint-config-custom-server": "workspace:*",
		"nodemon": "^2.0.22",
		"tsconfig": "workspace:*"
	}
}
