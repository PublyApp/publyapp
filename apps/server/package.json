{
	"name": "server",
	"version": "0.0.0",
	"scripts": {
		"// =============== BUILD COMMANDS =================": "================================",
		"build": "tsc && pnpm build:prod",
		"build:local": "cross-env MODE=local pnpm build:common",
		"build:prod": "cross-env MODE=production pnpm build:common",
		"build:preprod": "cross-env MODE=preprod pnpm build:common",
		"build:common": "pnpm build:rs",
		"build:rs": "node scripts/rsbuild/build.js",
		"build:es": "node scripts/esbuild/build.js",
		"// =============== START COMMANDs =================": "================================",
		"start": "pnpm start:prod",
		"start:local": "cross-env MODE=local pnpm start:common",
		"start:prod": "cross-env MODE=production pnpm start:common",
		"start:preprod": "cross-env MODE=preprod pnpm start:common",
		"start:common": "node --enable-source-maps dist/index.mjs",
		"// =============== DEV COMMANDs =================": "================================",
		"dev": "pnpm dev:local",
		"dev:local": "cross-env MODE=local pnpm dev:common",
		"dev:prod": "cross-env MODE=production pnpm dev:common",
		"dev:preprod": "cross-env MODE=preprod pnpm dev:common",
		"dev:common": "pnpm dev:rs",
		"dev:rs": "node scripts/rsbuild/watch.js",
		"dev:es": "node scripts/esbuild/watch.js",
		"// =============== LINT COMMANDS =================": "================================",
		"lint": "eslint . --ext ts,js",
		"lint:fix": "pnpm lint --fix",
		"// =============== SEED COMMANDS =================": "================================",
		"seed": "node --enable-source-maps dist/seed.mjs",
		"seed:debug": "node --enable-source-maps --inspect-brk dist/seed.mjs",
		"// =============== TEST COMMANDS =================": "================================",
		"postinstall": "node scripts/patch.js",
		"type-check": "tsc"
	},
	"dependencies": {
		"@devist/shared": "workspace:*",
		"@faker-js/faker": "^8.3.1",
		"@paralleldrive/cuid2": "^2.2.2",
		"@parse/fs-files-adapter": "^2.0.1",
		"@remix-run/express": "^2.8.0",
		"async": "^3.2.5",
		"axios": "^1.6.5",
		"body-parser": "^1.20.2",
		"chalk": "^5.3.0",
		"cloudinary": "^1.41.2",
		"cors": "^2.8.5",
		"cross-env": "^7.0.3",
		"datauri": "^4.1.0",
		"date-fns": "^2.25.0",
		"dayjs": "^1.11.10",
		"dotenv": "^16.3.1",
		"dotenv-expand": "^10.0.0",
		"esbuild-register": "^3.5.0",
		"express": "^4.18.2",
		"front": "workspace:*",
		"glob": "^10.3.12",
		"i18n-node": "^2.1.5",
		"i18next": "^23.8.2",
		"i18next-fs-backend": "^2.3.1",
		"image-size": "^1.1.1",
		"lodash": "^4.17.21",
		"mongodb": "^5.9.0",
		"mongoose": "^8.0.4",
		"ms": "^2.1.3",
		"multer": "1.4.5-lts.1",
		"nanoid": "^5.0.4",
		"numeral": "^2.0.6",
		"parse": "^5.1.0",
		"parse-dashboard": "^6.0.0-beta.1",
		"parse-server": "7.1.0-alpha.9",
		"qs": "^6.11.2",
		"sharp": "^0.33.3",
		"streamifier": "^0.1.1",
		"vhost": "^3.0.2",
		"winston": "^3.11.0",
		"winston-console-format": "^1.0.8",
		"zod": "^3.22.4",
		"zod-i18n-map": "^2.27.0"
	},
	"devDependencies": {
		"@rsbuild/core": "^0.7.9",
		"@rspack/cli": "^0.7.4",
		"@rspack/core": "^0.7.4",
		"@types/async": "^3.2.24",
		"@types/body-parser": "^1.19.5",
		"@types/chai": "^4.3.14",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/lodash": "^4.14.202",
		"@types/ms": "^0.7.34",
		"@types/multer": "^1.4.11",
		"@types/numeral": "^2.0.5",
		"@types/parse": "^3.0.9",
		"@types/qs": "^6.9.11",
		"@types/streamifier": "^0.1.2",
		"chai": "^5.1.0",
		"concurrently": "^8.2.2",
		"esbuild": "^0.19.11",
		"esbuild-node-externals": "^1.12.0",
		"eslint": "^8.56.0",
		"eslint-config-custom-server": "workspace:*",
		"line-replace": "^2.0.1",
		"nodemon": "^3.1.4",
		"replace-in-file": "^7.1.0",
		"supertest": "^6.3.4",
		"ts-node": "^10.9.2",
		"tsconfig": "workspace:*",
		"typescript": "^5.5.2"
	},
	"engines": {
		"node": ">=20.12.2"
	}
}
