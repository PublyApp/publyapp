{
	"name": "server",
	"version": "0.0.0",
	"scripts": {
		"build": "tsc && pnpm build:rs:prod",
		"build:local": "pnpm build:rs",
		"build:rs:prod": "cross-env APP_ENV=production pnpm build:rs",
		"build:rs:preprod": "cross-env APP_ENV=preprod pnpm build:rs",
		"build:rs": "node scripts/rsbuild/build.js",
		"start": "node --enable-source-maps dist/index.js",
		"dev": "node scripts/rsbuild/watch.js",
		"dev:old": "nodemon",
		"lint": "eslint . --ext ts,js",
		"lint:fix": " pnpm lint --fix",
		"seed": "node --enable-source-maps dist/seeding/seed.js",
		"dev2": "node watch.js"
	},
	"dependencies": {
		"@devist/shared": "workspace:*",
		"@faker-js/faker": "^8.3.1",
		"@paralleldrive/cuid2": "^2.2.2",
		"@parse/fs-files-adapter": "^2.0.1",
		"@rspack/core": "^0.4.4",
		"async": "^3.2.5",
		"cloudinary": "^1.41.1",
		"cors": "^2.8.5",
		"cross-env": "^7.0.3",
		"datauri": "^4.1.0",
		"dotenv": "^16.3.1",
		"dotenv-expand": "^10.0.0",
		"esbuild-register": "^3.5.0",
		"express": "^4.18.2",
		"i18n-node": "^2.1.5",
		"i18next": "^23.7.11",
		"i18next-fs-backend": "^2.3.1",
		"image-size": "^1.0.2",
		"lodash": "^4.17.21",
		"mongodb": "^6.3.0",
		"mongoose": "^8.0.3",
		"multer": "1.4.5-lts.1",
		"parse": "^4.3.1",
		"parse-dashboard": "^5.3.0",
		"parse-server": "^6.4.0",
		"qs": "^6.11.2",
		"sharp": "^0.32.6",
		"vhost": "^3.0.2",
		"winston": "^3.11.0",
		"winston-console-format": "^1.0.8",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@rsbuild/core": "^0.2.8",
		"@rspack/cli": "^0.4.4",
		"@types/async": "^3.2.24",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/lodash": "^4.14.202",
		"@types/multer": "^1.4.11",
		"@types/parse": "^3.0.9",
		"@types/qs": "^6.9.11",
		"concurrently": "^8.2.2",
		"esbuild": "^0.19.10",
		"esbuild-node-externals": "^1.12.0",
		"eslint": "^8.56.0",
		"eslint-config-custom-server": "workspace:*",
		"line-replace": "^2.0.1",
		"nodemon": "^3.0.2",
		"ts-node": "^10.9.2",
		"tsconfig": "workspace:*",
		"typescript": "^5.3.3"
	}
}
