{
	"extends": "tsconfig/tsconfig.base.json",
	"compilerOptions": {
		"target": "ESNext",

		"outDir": "dist",
		"baseUrl": "src",
		"paths": {
			"@server/*": ["*"],
			"@shared/*": ["../../packages/shared/*"]
		},

		"skipLibCheck": true,
	},
	"include": ["src", "@types"],
	"exclude": ["dist", "node_modules"]
}
