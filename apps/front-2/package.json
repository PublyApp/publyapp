		"lodash": "4.18.1",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hook-form": "7.54.2",
		"react-i18next": "14.1.3",
		"shadcn": "4.1.2",
		"srvx": "0.11.16",
		"tailwind-merge": "3.5.0",
