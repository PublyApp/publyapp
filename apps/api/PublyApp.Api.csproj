<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>PublyApp.Api</AssemblyName>
		<RootNamespace>PublyApp.Api</RootNamespace>
		<PublishDir>$(ApiArtifactsRoot)publish\</PublishDir>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="**/*.Spec.cs" />
		<Compile Remove="Lib/Testing/**/*.cs" />
		<Compile Remove="Tests/**/*.cs" />
		<None Remove="Lib/Testing/**" />
		<None Remove="Tests/**" />
		<Content Remove="Lib/Testing/**" />
		<Content Remove="Tests/**" />
		<EmbeddedResource Remove="Lib/Testing/**" />
		<EmbeddedResource Remove="Tests/**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DotNetEnv" />
		<PackageReference Include="FluentValidation.AspNetCore" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="Microsoft.OpenApi" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
		<PackageReference Include="Quartz" />
		<PackageReference Include="Resend" />
		<PackageReference Include="Scalar.AspNetCore" />
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="Serilog.Enrichers.Environment" />
		<PackageReference Include="Serilog.Enrichers.Thread" />
		<PackageReference Include="Serilog.Sinks.Async" />
		<PackageReference Include="Serilog.Sinks.Console" />
		<PackageReference Include="Serilog.Sinks.File" />
		<!-- Issue #255: traces + metrics only. No logging exporter by design (see OpenTelemetryConfigExtensions.cs). -->
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
		<PackageReference Include="NetEscapades.AspNetCore.SecurityHeaders" />
		<!-- for exporting openapi documents to json file at build time -->
		<PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Bogus" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource
			Include="../../packages/shared-ts/src/lib/profile-style/tenant-profile-icons.json"
			Link="Resources/profile-icons.json"
			LogicalName="PublyApp.ProfileIcons.json" />
	</ItemGroup>

	<!-- Wire the analyzer assembly into the API build without making it a runtime dependency.
	     OutputItemType="Analyzer" tells Roslyn to load the DLL as an in-process analyzer rather
	     than adding it to the output/publish set. ReferenceOutputAssembly="false" ensures the
	     analyzer DLL is never referenced or copied to the API's bin/ folder — it only runs at
	     compile time. -->
	<ItemGroup>
		<ProjectReference Include="../../packages/lint-cs/PublyApp.Analyzers.csproj"
						  OutputItemType="Analyzer"
						  ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- for exporting openapi documents to json file at build time.
	     Kept ON by default (non-Test): the openapi-spec-drift CI gate and
	     `just ci-spec-drift` rebuild through plain `dotnet build` and diff the
	     artifact — a default-off generation makes that gate vacuous (round-3
	     review). Local builds that do not want the boot run pass
	     `-property:OpenApiGenerateDocuments=false` explicitly, exactly as the
	     dev-api/db-* recipes already do. -->
	<PropertyGroup Condition="'$(Configuration)' != 'Test'">
		<OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
		<OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
		<OpenApiGeneratedProjectFile>$(MSBuildProjectDirectory)\PublyApp.Api.json</OpenApiGeneratedProjectFile>
		<OpenApiJsonFile>$(MSBuildProjectDirectory)\openapi.json</OpenApiJsonFile>
		<!-- Prevent duplicate assembly attributes when OpenAPI doc generation runs -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Test'">
		<OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
	</PropertyGroup>

	<!-- Generate translation keys before build. -->
	<PropertyGroup>
		<TranslationJsonFile>$(MSBuildProjectDirectory)\..\..\packages\shared-ts\src\lib\i18n\json\response-message.en.json</TranslationJsonFile>
		<GeneratedKeysFile>$(MSBuildProjectDirectory)\Localization\ResponseKeys.g.cs</GeneratedKeysFile>
		<TranslationKeyGenProject>$(MSBuildProjectDirectory)\..\..\packages\scripts-cs\PublyApp.Scripts.csproj</TranslationKeyGenProject>
	</PropertyGroup>

	<ItemGroup>
		<TranslationKeyGenSources Include="$(MSBuildProjectDirectory)\..\..\packages\scripts-cs\**\*.cs" />
		<TranslationKeyGenSources Include="$(MSBuildProjectDirectory)\..\..\packages\scripts-cs\*.csproj" />
	</ItemGroup>

	<!-- Private artifact directories for the codegen `dotnet run` below (see
	     the race comment inside GenerateTranslationKeys). Passed as environment
	     variables — the strongest override channel an Exec offers: they are
	     plain properties, so they beat the conditional Directory.Build.props
	     defaults regardless of Configuration, and they cannot be clobbered by
	     later property re-evaluation the way a target-scoped PropertyGroup
	     could be. The child MSBuild reads them as global properties, so its
	     outputs never collide with the solution's own build of Scripts. -->
	<ItemGroup>
		<TranslationKeyGenEnv Include="BaseOutputPath=$(MSBuildProjectDirectory)\..\..\packages\scripts-cs\.artifacts\codegen\bin\" />
		<TranslationKeyGenEnv Include="BaseIntermediateOutputPath=$(MSBuildProjectDirectory)\..\..\packages\scripts-cs\.artifacts\codegen\obj\" />
	</ItemGroup>

	<Target Name="GenerateTranslationKeys"
			BeforeTargets="BeforeBuild"
			Condition="'$(Configuration)' != 'Test'"
			Inputs="$(TranslationJsonFile);@(TranslationKeyGenSources)"
			Outputs="$(GeneratedKeysFile)">
		<Message Text="Generating translation keys from response-message.en.json..."
				 Importance="high" />
		<!-- This Exec races the solution build itself: when PublyApp.slnx builds
		     (quality-gate, just build-api), MSBuild node 2 compiles Scripts in its
		     own .artifacts while this target's `dotnet run` rebuilds Scripts in
		     the same Debug directories on node 1 — two processes creating
		     PublyApp.Scripts.runtimeconfig.json concurrently fails with MSB4018
		     "being used by another process" (observed cold-cache on CI and
		     locally). Redirect THIS invocation's artifacts to a private directory
		     via plain environment variables: simple properties win over the
		     conditional defaults in Directory.Build.props (they are already set,
		     so those conditions stay false) and satisfy the .artifacts guard in
		     Directory.Build.targets. The solution's own build of Scripts is then
		     never touched by the codegen subprocess, under any configuration. -->
		<Exec Command="dotnet run --project &quot;$(TranslationKeyGenProject)&quot; -- generate-translation-keys &quot;$(TranslationJsonFile)&quot; &quot;$(GeneratedKeysFile)&quot;"
			  EnvironmentVariables="@(TranslationKeyGenEnv)"
			  ContinueOnError="false" />
	</Target>

	<Target Name="RenameOpenApiDocument"
			AfterTargets="GenerateOpenApiDocuments"
			Condition="'$(Configuration)' != 'Test' And Exists('$(OpenApiGeneratedProjectFile)')">
		<Copy SourceFiles="$(OpenApiGeneratedProjectFile)"
			  DestinationFiles="$(OpenApiJsonFile)"
			  SkipUnchangedFiles="true" />
		<Delete Files="$(OpenApiGeneratedProjectFile)" />
	</Target>
</Project>
