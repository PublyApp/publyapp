{
	"name": "api",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "dotnet watch --project MainApi.csproj",
		"build": "dotnet build MainApi.csproj",
		"publish": "dotnet publish",
		"db:reset": "dotnet ef database drop -f && dotnet ef database update",
		"migrate:add": "dotnet ef migrations add",
		"migrate:apply": "dotnet ef database update",
		"migrate:remove": "dotnet ef migrations remove",
		"seed": "dotnet ef database seed"
	}
}
