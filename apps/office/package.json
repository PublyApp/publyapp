{
	"name": "office",
	"version": "0.0.0",
	"private": true,
	"type": "commonjs",
	"scripts": {
		"build": "pnpm run build:prod",
		"build:prod": "cross-env APP_ENV='production' pnpm run build:pack",
		"build:preprod": "cross-env APP_ENV='preprod' pnpm run build:pack",
		"dev": "cross-env APP_ENV='local' pnpm run dev:pack",
		"build:pack": "tsc && rspack build",
		"dev:pack": "rspack serve",
		"lint": "eslint src --ext ts,tsx --max-warnings 0",
		"lint:fix": "pnpm run lint --fix"
	},
	"dependencies": {
		"@devist/shared": "workspace:*",
		"@devist/ui-react": "workspace:*",
		"@emotion/react": "^11.11.1",
		"@emotion/styled": "^11.11.0",
		"@hookform/resolvers": "^3.3.1",
		"@mui/icons-material": "^5.14.11",
		"@mui/material": "^5.14.11",
		"@tanstack/react-query": "5.0.0-beta.35",
		"@tanstack/react-table": "^8.10.3",
		"@tiptap/core": "^2.1.11",
		"@tiptap/extension-color": "^2.1.11",
		"@tiptap/extension-list-item": "^2.1.11",
		"@tiptap/extension-text-style": "^2.1.11",
		"@tiptap/pm": "^2.1.11",
		"@tiptap/react": "^2.1.11",
		"@tiptap/starter-kit": "^2.1.11",
		"lodash": "^4.17.21",
		"material-react-table": "^1.15.0",
		"parse": "^4.2.0",
		"qs": "^6.11.2",
		"query-string": "^8.1.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-error-boundary": "^4.0.11",
		"react-hook-form": "^7.46.2",
		"react-i18next": "^12.3.1",
		"react-lazily": "^0.9.2",
		"react-router-dom": "^6.16.0",
		"react-toastify": "^9.1.3",
		"react-use": "^17.4.0",
		"use-immer": "^0.9.0",
		"use-query-params": "^2.2.1",
		"zod": "^3.22.2"
	},
	"devDependencies": {
		"@rspack/cli": "^0.3.5",
		"@rspack/core": "^0.3.5",
		"@types/lodash": "^4.14.199",
		"@types/parse": "^3.0.5",
		"@types/react": "^18.2.23",
		"@types/react-dom": "^18.2.8",
		"@typescript-eslint/eslint-plugin": "^5.62.0",
		"@typescript-eslint/parser": "^5.62.0",
		"cross-env": "^7.0.3",
		"dotenv": "^16.3.1",
		"dotenv-expand": "^10.0.0",
		"eslint": "^8.50.0",
		"eslint-config-custom-react": "workspace:*",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-react-refresh": "^0.3.5",
		"tsconfig": "workspace:*",
		"typescript": "^5.2.2"
	}
}
