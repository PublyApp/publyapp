{
	"name": "office",
	"version": "0.0.0",
	"private": true,
	"type": "commonjs",
	"scripts": {
		"build": "pnpm run build:prod",
		"build:prod": "cross-env APP_ENV='production' pnpm run build:pack",
		"build:preprod": "cross-env APP_ENV='preprod' pnpm run build:pack",
		"dev": "cross-env APP_ENV='local' pnpm run dev:pack",
		"build:pack": "tsc && rspack build",
		"dev:pack": "rspack serve",
		"lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "pnpm run lint --fix"
	},
	"dependencies": {
		"@aktiveo/shared": "workspace:*",
		"@aktiveo/ui-react": "workspace:*",
		"@emotion/react": "^11.11.1",
		"@emotion/styled": "^11.11.0",
		"@hookform/resolvers": "^3.3.1",
		"@mui/icons-material": "^5.14.8",
		"@mui/material": "^5.14.8",
		"@tanstack/react-query": "5.0.0-alpha.71",
		"@tanstack/react-table": "^8.9.7",
		"@tiptap/pm": "^2.1.8",
		"@tiptap/react": "^2.1.8",
		"@tiptap/starter-kit": "^2.1.8",
		"lodash": "^4.17.21",
		"material-react-table": "^1.14.0",
		"parse": "^4.1.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-hook-form": "^7.46.1",
		"react-i18next": "^12.3.1",
		"react-router-dom": "^6.15.0",
		"react-use": "^17.4.0",
		"use-immer": "^0.9.0",
		"zod": "^3.22.2"
	},
	"devDependencies": {
		"@rspack/cli": "^0.3.2",
		"@rspack/core": "^0.3.2",
		"@types/lodash": "^4.14.198",
		"@types/parse": "^3.0.4",
		"@types/react": "^18.2.21",
		"@types/react-dom": "^18.2.7",
		"@typescript-eslint/eslint-plugin": "^5.62.0",
		"@typescript-eslint/parser": "^5.62.0",
		"cross-env": "^7.0.3",
		"dotenv": "^16.3.1",
		"dotenv-expand": "^10.0.0",
		"eslint": "^8.48.0",
		"eslint-config-custom-react": "workspace:*",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-react-refresh": "^0.3.5",
		"tsconfig": "workspace:*",
		"typescript": "^5.2.2"
	}
}
