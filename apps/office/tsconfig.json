{
	"extends": "tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES6",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",

    "jsx": "react-jsx",

		"baseUrl": "src",
		"paths": {
			"@office/*": ["*"],
			"@ui-react/*": ["../../packages/ui-react/*"],
			"@shared/*": ["../../packages/shared/*"]
		},
  },
	"include": ["src"],
  "exclude": ["node_modules", "dist"],
}
