<Project>
  <!-- Enable Central Package Management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Promote PackageVersion entries below to top-level so they override transitive
         dependency versions (used for security pins; NU1109 still blocks downgrades) -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Central package version definitions -->
  <ItemGroup>
    <!-- ASP.NET Core packages -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.11" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />
    <!-- Third-party packages -->
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!-- Transitive-pinned so every project resolves the same patch level:
         Npgsql.EFCore.PostgreSQL otherwise drags Tests back below 10.0.11 (CS1705).
         Npgsql's latest 10.x is 10.0.3 (no 10.0.11 exists yet); keep this one entry
         behind until Npgsql ships a matching patch. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Quartz" Version="3.19.1" />
    <PackageVersion Include="Resend" Version="0.1.6" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.1" />
    <PackageVersion Include="Polly" Version="8.7.0" />
    <!-- Logging packages -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="3.1.0" />
    <PackageVersion Include="Serilog.Sinks.Async" Version="2.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- OpenTelemetry (issue #255): TRACES AND METRICS ONLY.
         Deliberately pinned as one lockstep family: mixed OTel component versions
         are a known source of runtime InvalidOperationException in the .NET SDK.
         NOTE FOR REVIEWERS: there is intentionally NO logging exporter here and NO
         Serilog.Sinks.OpenTelemetry — every log sink must stay behind the sanitizer
         wrapper (apps/api/Lib/Extensions/LoggerConfigExtensions.cs structural
         invariant). OpenTelemetryConfigExtensions.cs + its guard spec pin this;
         adding either package means redesigning that decision, not bumping a
         version. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />

    <!-- Aspire AppHost (issue #255): LOCAL DEV ORCHESTRATION ONLY — production stays
         on dokploy.yml and e2e on docker-compose.test.yml, both unchanged. Never
         reference these packages from apps/api. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.5.3" />
    <!-- Security packages -->
    <PackageVersion Include="NetEscapades.AspNetCore.SecurityHeaders" Version="1.3.1" />

    <!-- Testing packages -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.1" />
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />

    <!-- Analyzer packages -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>
  <!-- Transitive security pins (with CentralPackageTransitivePinningEnabled these
       override the resolved version of transitive dependencies):
       System.Security.Cryptography.Xml is pulled by DataProtection; advisories
       GHSA-37gx-xxp4-5rgx / GHSA-cvvh-rhrc-wg4q et al. are patched at 10.0.10.
       Keep the pin at the latest 10.x patch (>= the version DataProtection requires)
       so NU1109 never fires: bump in lockstep when DataProtection moves. -->
  <ItemGroup Label="TransitiveSecurityPins">
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>
</Project>
