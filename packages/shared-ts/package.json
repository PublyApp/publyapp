{
	"name": "@org/shared-ts",
	"version": "0.0.0",
	"exports": {
		"./*": {
			"types": [
				"./src/*.ts"
			],
			"default": [
				"./src/*.ts"
			]
		}
	},
	"scripts": {
		"postinstall": "node src/scripts/generate-zod-i18n-map.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"dayjs": "^1.11.10",
		"i18next": "^26.3.6",
		"lodash": "^4.17.21",
		"ms": "^2.1.3",
		"nanoid": "^5.1.16",
		"posthog-js": "1.268.1",
		"posthog-node": "5.47.2",
		"winston": "^3.11.0",
		"winston-console-format": "^1.0.8",
		"winston-transport-browserconsole": "^1.0.5",
		"zod": "~3.24.4",
		"zod-i18n-map": "^2.27.0"
	},
	"devDependencies": {
		"@types/lodash": "^4.14.202",
		"@types/ms": "^2.1.0",
		"tsconfig": "workspace:*",
		"vitest": "4.1.9"
	}
}
