{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.base.json",
	"display": "Next.js",
	"compilerOptions": {
		"plugins": [{ "name": "next" }],
		"allowJs": true,
		"declaration": false,
		"declarationMap": false,
		"incremental": true,
		"jsx": "preserve",
		"lib": ["dom", "dom.iterable", "ESNEXT"],
		"module": "ESNEXT",
		"noEmit": true,
		"resolveJsonModule": true,
		"strict": false,
		"target": "es5"
	},
	"include": ["src", "next-env.d.ts"],
	"exclude": ["node_modules"]
}
