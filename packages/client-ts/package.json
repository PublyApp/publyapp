{
	"name": "@org/client-ts",
	"license": "Apache-2.0",
	"version": "0.0.1",
	"exports": {
		"./*": {
			"types": [
				"./src/*.ts"
			],
			"default": [
				"./src/*.ts"
			]
		}
	},
	"scripts": {
		"kiota:generate": "dotnet kiota generate -d ../../apps/api/openapi.json -o src -l typescript -n PublyApp.Api.Client -c ApiClient",
		"kiota:update": "dotnet kiota update -o src",
		"kiota:info": "dotnet kiota info -d ../../apps/api/openapi.json -l typeScript",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@microsoft/kiota-abstractions": "1.0.0-preview.103",
		"@microsoft/kiota-serialization-form": "1.0.0-preview.103",
		"@microsoft/kiota-serialization-json": "1.0.0-preview.103",
		"@microsoft/kiota-serialization-multipart": "1.0.0-preview.103",
		"@microsoft/kiota-serialization-text": "1.0.0-preview.106"
	}
}
