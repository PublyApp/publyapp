{
	"extends": "tsconfig/tsconfig.base.json",
	"compilerOptions": {
		"target": "ES6",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",

		"jsx": "react-jsx",

		"baseUrl": ".",
		"paths": {
			"@ui-react/*": ["*"],
			"@shared/*": ["../../packages/shared/*"]
		}
	},
	"include": ["."],
	"exclude": [/* "dist", "build",  */ "node_modules"]
}
