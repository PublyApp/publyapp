{
	"name": "@org/lint-ts",
	"version": "0.0.0",
	"private": true,
	"description": "Custom Oxlint JS plugin for PublyApp repo-specific lint rules (loaded via Oxlint jsPlugins).",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.79.0",
		"oxlint": "1.79.0",
		"vitest": "4.1.11"
	}
}
