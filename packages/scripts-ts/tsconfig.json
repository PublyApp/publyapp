{
	"extends": "../_tsconfig/tsconfig.base.json",
	"compilerOptions": {
		"allowJs": false,
		"checkJs": false,
		"declaration": false,
		"declarationMap": false,
		"module": "ESNext",
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"target": "ES2022",
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
