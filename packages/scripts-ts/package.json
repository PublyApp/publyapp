{
	"name": "@org/scripts-ts",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Repo CI/review/deploy scripts as a TypeScript-only pnpm workspace package (run with bare node on Node 24).",
	"exports": {
		".": {
			"types": ["./src/*.ts"],
			"default": ["./src/*.ts"]
		},
		"./src/*": {
			"types": ["./src/*.ts"],
			"default": ["./src/*.ts"]
		}
	},
	"scripts": {
		"test": "vitest run"
	},
	"devDependencies": {
		"yaml": "2.8.3",
		"@types/node": "^24.13.3",
		"vitest": "4.1.11"
	}
}
