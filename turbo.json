{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalEnv": [
		"ONLINE",
		"PORT",
		"DATABASE_URI",
		"MASTER_KEY",
		"SERVER_URL",
		"NODE_ENV",
		"APP_ENV",
		"MODE",
		"REST_API_KEY",
		"PARSE_SERVER_URL",
		"FRONT_URL",
		"TEST_ONLINE",
		"VITE_SERVER_URL",
		"VITE_PARSE_SERVER_URL",
		"VITE_REST_API_KEY",
		"VITE_API_PATH",
		"VITE_PARSE_PATH",
		"API_PATH",
		"PARSE_PATH",
		"DEV",
		"JOB_INPUT",
		"SERVER_API_BASE_URL",
		"PUBLIC_API_BASE_URL",
		"VITE_POSTHOG_PROJECT_TOKEN",
		"PUBLIC_POSTHOG_PROJECT_TOKEN",
		"POSTHOG_PROJECT_TOKEN"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				".svelte-kit",
				"dist",
				"build",
				".output/**"
			]
		},
		"build:local": {
			"dependsOn": ["^build:local"],
			"outputs": [".next/**", "!.next/cache/**", ".svelte-kit", "dist", "build"]
		},
		"lint": {
			"cache": false
		},
		"lint:fix": {
			"cache": false
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
