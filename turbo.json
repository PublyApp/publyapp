{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
			"cache": false
		},
		"lint:fix": {
			"cache": false
		},
    "dev": {
      "cache": false
    }
  }
}
