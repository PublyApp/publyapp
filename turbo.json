{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"globalEnv": ["ONLINE", "PRODUCTION", "PORT", "DATABASE_URI", "MASTER_KEY", "SERVER_URL", "NODE_ENV", "APP_ENV"],
	"pipeline": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", ".svelte-kit", "dist", "build"]
		},
		"lint": {
			"cache": false
		},
		"lint:fix": {
			"cache": false
		},
		"dev": {
			"cache": false
		}
	}
}
