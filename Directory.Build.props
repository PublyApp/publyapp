<Project>
  <PropertyGroup>
    <DotNetArtifactsRoot Condition="'$(DotNetArtifactsRoot)' == ''">$(MSBuildProjectDirectory)\.artifacts\</DotNetArtifactsRoot>
    <LocalArtifactExcludes>.artifacts\**\*;bin\**\*;obj\**\*</LocalArtifactExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(LocalArtifactExcludes)</DefaultItemExcludes>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">$(DotNetArtifactsRoot)bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == ''">$(DotNetArtifactsRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <!-- Common properties for all projects -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>IDE0130</WarningsAsErrors>
    <WarningsNotAsErrors />
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress XML comment warnings - existing code has incomplete/mismatched docs -->
    <NoWarn>$(NoWarn);CS1591;CS1572;CS1573;CS1570</NoWarn>
    <!-- Disable NuGet audit: transitive vulnerability advisories in
         System.Security.Cryptography.Xml (pulled by DataProtection) are not
         actionable until the upstream ships a patch. These do not affect
         Data Protection key-ring encryption at rest (AES-256-GCM). -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- Common metadata -->
  <PropertyGroup>
    <Company>PublyApp</Company>
    <Product>PublyApp Application</Product>
    <Copyright>Copyright © PublyApp 2026</Copyright>
  </PropertyGroup>

  <!-- Build configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
</Project>
