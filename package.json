{
	"name": "pdf-vite",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"// =============== BUILD SCRIPTS ===============": "=============================",
		"build": "turbo build",
		"build:local": "turbo build:local",
		"build:deploy": "bun ./scripts/deploy.mjs",
		"// =============== START SCRIPTS ===============": "=============================",
		"start:test-online": "bun run --filter server start:test-online",
		"// =============== DEV SCRIPTS ===============": "=============================",
		"dev": "turbo dev",
		"dev:server": "bun run --filter server dev",
		"dev:front": "bun run --filter front dev",
		"// =============== TSC SCRIPTS ===============": "=============================",
		"tsc:server": "bun run --filter server type-check",
		"tsc:front": "bun run --filter front type-check",
		"// =============== SEED COMMANDS =================": "================================",
		"seed": "bun run --filter server seed",
		"seed:debug": "bun run --filter server seed:debug",
		"// =============== LINTING ===============": "================================",
		"format:check": "biome format .",
		"format:write": "biome format --write .",
		"lint:check": "biome lint",
		"lint:write": "biome lint --write .",
		"// =============== MISC ===============": "================================",
		"knip": "knip",
		"prepare": "husky",
		"update-deps": "??? in bun ???"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^20.14.15",
		"archiver": "^7.0.1",
		"dotenv": "^16.3.1",
		"fs-extra": "^11.2.0",
		"husky": "^9.0.11",
		"knip": "^5.46.4",
		"lint-staged": "^15.2.0",
		"tsconfig": "workspace:*",
		"turbo": "^2.0.3",
		"typescript": "^5.8.3",
		"lodash": "^4.17.21"
	},
	"packageManager": "bun@1.2.12",
	"engines": {
		"node": ">=v22.x",
		"bun": ">=1.2.12"
	},
	"trustedDependencies": ["sharp"],
	"workspaces": ["apps/*", "packages/*", "jobs"]
}
