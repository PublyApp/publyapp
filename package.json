{
	"name": "devist-platform",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "pnpm turbo build --filter server --filter front",
		"postbuild": "pnpm i --filter server --filter front",
		"dev": "pnpm turbo dev",
		"check-format": "prettier --check .",
		"format": "prettier --write .",
		"lint": "pnpm turbo lint",
		"lint:fix": "pnpm turbo lint:fix",
		"prepare": "husky install",
		"pre-commit:old": "pnpm format && git add -A .",
		"prepare:deploy": "pnpm prepare:deploy:server && pnpm prepare:deploy:awesome",
		"prepare:deploy:server": "node ./scripts/deploy/server/index.js",
		"prepare:deploy:awesome": "node ./scripts/deploy/awsm/index.js",
		"update-deps": "node ./scripts/updateDeps/index.js"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.1.1",
		"eslint": "^8.56.0",
		"eslint-config-custom-base": "workspace:*",
		"fs-extra": "^11.2.0",
		"husky": "^8.0.3",
		"lint-staged": "^15.2.0",
		"prettier": "^3.2.2",
		"tsconfig": "workspace:*",
		"turbo": "^1.12.2",
		"typescript": "^5.3.3"
	},
	"packageManager": "pnpm@8.15.1",
	"engines": {
    "node": ">=16.0.0"
  }
}
