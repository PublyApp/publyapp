{
	"name": "pdf-vite",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"// =============== BUILD SCRIPTS ===============": "=============================",
		"build": "turbo build",
		"build:local": "turbo build:local",
		"build:deploy": "node ./scripts/deploy.mjs",
		"// =============== START SCRIPTS ===============": "=============================",
		"start:railway": "pnpm --filter server run start",
		"start:test-online": "pnpm --filter server run start:test-online",
		"// =============== DEV SCRIPTS ===============": "=============================",
		"dev": "turbo dev",
		"dev:server": "pnpm --filter server run dev",
		"dev:front": "pnpm --filter front run dev",
		"// =============== TSC SCRIPTS ===============": "=============================",
		"tsc:server": "pnpm --filter server run type-check",
		"tsc:front": "pnpm --filter front run type-check",
		"// =============== SEED COMMANDS =================": "================================",
		"seed": "pnpm --filter server run seed",
		"seed:debug": "pnpm --filter server run seed:debug",
		"// =============== LINTING ===============": "================================",
		"format:check": "biome format .",
		"format:write": "biome format --write .",
		"lint:check": "biome lint",
		"lint:write": "biome lint --write .",
		"// =============== MISC ===============": "================================",
		"knip": "knip",
		"prepare": "husky",
		"update-deps": "pnpm up -i -r"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^20.14.15",
		"archiver": "^7.0.1",
		"dotenv": "^16.3.1",
		"fs-extra": "^11.2.0",
		"husky": "^9.0.11",
		"knip": "^5.46.4",
		"lint-staged": "^15.2.0",
		"tsconfig": "workspace:*",
		"turbo": "^2.0.3",
		"typescript": "^5.5.4",
		"lodash": "^4.17.21"
	},
	"packageManager": "pnpm@8.15.7",
	"engines": {
		"node": ">=v22.x"
	},
	"trustedDependencies": ["sharp"]
}
