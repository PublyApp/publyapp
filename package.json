{
	"name": "platform",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "prettier --write .",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"prepare": "husky install",
		"pre-commit": "npm run format && git add -A ."
	},
	"devDependencies": {
		"eslint": "^8.40.0",
		"eslint-config-custom": "*",
		"prettier": "^2.8.8",
		"turbo": "^1.9.3",
		"husky": "^8.0.0"
	},
	"packageManager": "npm@9.5.1"
}
