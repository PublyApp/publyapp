{
  "name": "devist-platform",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm turbo build",
    "dev": "pnpm turbo dev",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prepare": "husky install",
    "update-deps": "pnpm update",
    "update-deps:pnpm": "pnpm up -i -r",
    "pre-commit:old": "pnpm format && git add -A .",
    "prepare:deploy:server": "pnpm ./scripts/deploy/server/index.js"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.1.1",
    "eslint": "^8.56.0",
    "eslint-config-custom-base": "workspace:*",
    "fs-extra": "^11.2.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.2",
    "tsconfig": "workspace:*",
    "turbo": "^1.12.2",
    "typescript": "^5.3.3"
  },
	"packageManager": "pnpm@8.15.7",
	"engines": {
    "node": ">=20.12.2"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
