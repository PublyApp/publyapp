{
	"name": "publyapp",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy:artifacts": "node ./scripts/deploy.mjs",
		"format": "oxfmt --check \".lintstagedrc.js\" \"dfs.config.cjs\" \"knip.ts\" \"package.json\" \"turbo.json\" \".oxlintrc.json\" \".oxfmtrc.json\" \"scripts/**/*.{js,mjs,cjs}\" \"apps/api/**/*.{js,mjs,cjs,json}\" \"apps/front/**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\" \"packages/_tsconfig/**/*.json\" \"packages/shared-ts/**/*.{js,jsx,ts,tsx,mjs,cjs,json}\"",
		"format:write": "oxfmt --write \".lintstagedrc.js\" \"dfs.config.cjs\" \"knip.ts\" \"package.json\" \"turbo.json\" \".oxlintrc.json\" \".oxfmtrc.json\" \"scripts/**/*.{js,mjs,cjs}\" \"apps/api/**/*.{js,mjs,cjs,json}\" \"apps/front/**/*.{js,jsx,ts,tsx,mjs,cjs,json,css}\" \"packages/_tsconfig/**/*.json\" \"packages/shared-ts/**/*.{js,jsx,ts,tsx,mjs,cjs,json}\"",
		"lint": "oxlint --quiet .",
		"lint:fix": "oxlint --fix --quiet .",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/node": "^20.19.7",
		"chokidar": "^4.0.3",
		"dokploy-from-source": "1.1.0",
		"dotenv": "^17.2.0",
		"fs-extra": "^11.2.0",
		"husky": "^9.0.11",
		"json": "^11.0.0",
		"knip": "5.66.0",
		"lint-staged": "^15.5.2",
		"listr2": "^10.2.1",
		"lodash": "^4.17.21",
		"markdownlint-cli": "^0.45.0",
		"oxfmt": "0.47.0",
		"oxlint": "1.62.0",
		"oxlint-tsgolint": "0.22.1",
		"tsconfig": "workspace:*",
		"turbo": "^2.0.3",
		"typescript": "^6.0.2"
	},
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=v24.x",
		"bun": ">=1.2.17"
	},
	"pnpm": {
		"packageExtensions": {
			"@hookform/resolvers@4.1.3": {
				"peerDependencies": {
					"zod": "^3.24.4"
				}
			}
		}
	},
	"trustedDependencies": [
		"sharp"
	],
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		]
	},
	"dependencies": {
		"cookie": "^1.0.2",
		"isbot": "^5.1.28",
		"nprogress": "^0.2.0",
		"serialize-error": "^12.0.0"
	}
}
