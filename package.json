{
	"name": "platform",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "prettier --write .",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix"
	},
	"devDependencies": {
		"eslint": "^8.40.0",
		"eslint-config-custom": "*",
		"husky": "^8.0.3",
		"prettier": "^2.8.8",
		"turbo": "^1.9.3"
	},
	"packageManager": "npm@9.5.1",
	"husky": {
		"hooks": {
			"pre-commit": "prettier --write . && git add -A ."
		}
	}
}
