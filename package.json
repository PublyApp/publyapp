{
	"name": "pdf-vite",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"// =============== BUILD SCRIPTS ===============": "=============================",
		"build": "turbo build",
		"build:local": "turbo build:local",
		"build:deploy": "node ./scripts/deploy.mjs",
		"// =============== START SCRIPTS ===============": "=============================",
		"start:test-online": "pnpm run --filter server start:test-online",
		"// =============== DEV SCRIPTS ===============": "=============================",
		"dev": "turbo dev",
		"dev:server": "pnpm run dev:server:pnpm",
		"dev:front": "pnpm run dev:front:pnpm",
		"dev:server:bun": "bun run --filter server --elide-lines 0 dev",
		"dev:front:bun": "bun run --filter front --elide-lines 0 dev",
		"dev:server:pnpm": "pnpm run --filter server dev",
		"dev:front:pnpm": "pnpm run --filter front dev",
		"// =============== TSC SCRIPTS ===============": "=============================",
		"tsc:server": "pnpm run tsc:server:pnpm",
		"tsc:front": "pnpm run tsc:front:pnpm",
		"tsc:server:bun": "bun run --filter server type-check",
		"tsc:front:bun": "bun run --filter front type-check",
		"tsc:server:pnpm": "pnpm run --filter server type-check",
		"tsc:front:pnpm": "pnpm run --filter front type-check",
		"// =============== SEED COMMANDS =================": "================================",
		"seed": "bun run --filter server seed",
		"seed:debug": "bun run --filter server seed:debug",
		"// =============== LINTING ===============": "================================",
		"biome:format": "biome format .",
		"biome:format:write": "biome format --write .",
		"biome:lint": "biome lint",
		"biome:lint:write": "biome lint --write .",
		"biome:check": "biome check .",
		"biome:check:fix": "biome check --write .",
		"// =============== MISC ===============": "================================",
		"knip": "knip",
		"prepare": "husky",
		"update-deps": "pnpm up -r",
		"generate:client": "pnpm run --filter @org/js-client kiota:generate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.1",
		"@types/node": "^20.19.7",
		"archiver": "^6.0.2",
		"chokidar": "^4.0.3",
		"dotenv": "^17.2.0",
		"fs-extra": "^11.2.0",
		"husky": "^9.0.11",
		"json": "^11.0.0",
		"knip": "^5.46.4",
		"lint-staged": "^15.5.2",
		"lodash": "^4.17.21",
		"tsconfig": "workspace:*",
		"turbo": "^2.0.3",
		"typescript": "^5.8.3"
	},
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=v24.x",
		"bun": ">=1.2.17"
	},
	"trustedDependencies": [
		"sharp"
	],
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		]
	},
	"dependencies": {
		"cookie": "^1.0.2",
		"isbot": "^5.1.28",
		"nprogress": "^0.2.0",
		"serialize-error": "^12.0.0"
	}
}
