{
  "name": "pdf-vite",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "// =============== BUILD SCRIPTS ===============": "=============================",
    "build": "turbo build",
    "build:local": "turbo build:local",
    "build:railway": "turbo build --filter server --force",
    "build:local:railway": "turbo build:local --filter server --force",
    "// =============== START SCRIPTS ===============": "=============================",
    "start:railway": "pnpm --filter server run start",
    "start:test-online": "pnpm --filter server run start:test-online",
    "// =============== DEV SCRIPTS ===============": "=============================",
    "dev": "turbo dev",
    "dev:server": "pnpm --filter server run dev",
    "dev:front": "pnpm --filter front run dev",
    "// =============== TSC SCRIPTS ===============": "=============================",
    "tsc:server": "pnpm --filter server run type-check",
    "tsc:front": "pnpm --filter front run type-check",
    "// =============== SEED COMMANDS =================": "================================",
    "seed": "pnpm --filter server run seed",
    "seed:debug": "pnpm --filter server run seed:debug",
    "// =============== MISC ===============": "================================",
    "format": "prettier --write .",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "prepare": "husky",
    "update-deps": "pnpm up -i -r",
    "check-format": "prettier --check .",
    "build:deploy": "node ./scripts/deploy.mjs",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.1.1",
    "@types/node": "^20.14.15",
    "archiver": "^7.0.1",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "eslint-config-custom-base": "workspace:*",
    "fs-extra": "^11.2.0",
    "husky": "^9.0.11",
    "knip": "^5.46.4",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.2",
    "tsconfig": "workspace:*",
    "turbo": "^2.0.3",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@8.15.7",
  "engines": {
    "node": ">=20.12.2"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
