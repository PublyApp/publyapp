# React Date Handling with Day.js

## Rule Overview

**CRITICAL:** This project uses Day.js for all date manipulation and formatting. Never use date-fns, Moment.js, or native Date methods for formatting.

## Why Day.js?

- Lightweight (2KB)
- Immutable API
- Same API as Moment.js
- Already installed and configured in the project
- Consistent with Material-UI Date Pickers

## Import Pattern

```tsx
// ✅ CORRECT - Import dayjs
import dayjs from 'dayjs';
import relativeTime from 'dayjs/plugin/relativeTime';
import utc from 'dayjs/plugin/utc';
import timezone from 'dayjs/plugin/timezone';

// Enable plugins as needed
dayjs.extend(relativeTime);
dayjs.extend(utc);
dayjs.extend(timezone);

// ❌ WRONG - Don't use date-fns
import { formatDistanceToNow, format } from 'date-fns';

// ❌ WRONG - Don't use Moment.js
import moment from 'moment';
```

## Common Operations

### Formatting Dates

```tsx
// ❌ WRONG - Using date-fns
import { format } from 'date-fns';
const formatted = format(new Date(), 'MMM dd, yyyy');

// ✅ CORRECT - Using dayjs
import dayjs from 'dayjs';
const formatted = dayjs(date).format('MMM DD, YYYY');
```

**Common format patterns:**
```tsx
dayjs(date).format('YYYY-MM-DD');           // 2024-11-08
dayjs(date).format('MMM DD, YYYY');         // Nov 08, 2024
dayjs(date).format('DD/MM/YYYY');           // 08/11/2024
dayjs(date).format('MMMM D, YYYY');         // November 8, 2024
dayjs(date).format('h:mm A');               // 3:30 PM
dayjs(date).format('YYYY-MM-DD HH:mm:ss');  // 2024-11-08 15:30:00
```

### Relative Time ("time ago")

```tsx
// ❌ WRONG - Using date-fns
import { formatDistanceToNow } from 'date-fns';
const timeAgo = formatDistanceToNow(new Date(date), { addSuffix: true });

// ✅ CORRECT - Using dayjs with relativeTime plugin
import dayjs from 'dayjs';
import relativeTime from 'dayjs/plugin/relativeTime';
dayjs.extend(relativeTime);

const timeAgo = dayjs(date).fromNow();         // "2 hours ago"
const timeAgoNoSuffix = dayjs(date).from();    // "2 hours"
const timeTo = dayjs(date).toNow();            // "in 2 hours"
```

### Parsing Dates

```tsx
// ✅ CORRECT - Parse different date formats
dayjs('2024-11-08');                    // From ISO string
dayjs(new Date());                       // From Date object
dayjs(1699459200000);                    // From timestamp
dayjs('08/11/2024', 'DD/MM/YYYY');      // Custom format
```

### Date Manipulation

```tsx
// ✅ Add/Subtract
dayjs(date).add(7, 'day');              // Add 7 days
dayjs(date).subtract(1, 'month');       // Subtract 1 month
dayjs(date).add(2, 'hour');             // Add 2 hours

// ✅ Start/End of time period
dayjs(date).startOf('month');           // Start of month
dayjs(date).endOf('week');              // End of week
dayjs(date).startOf('day');             // Start of day (00:00:00)

// ✅ Set specific values
dayjs(date).set('year', 2025);          // Set year
dayjs(date).set('month', 0);            // Set month (0 = January)
dayjs(date).set('date', 15);            // Set day of month
```

### Date Comparisons

```tsx
const date1 = dayjs('2024-11-08');
const date2 = dayjs('2024-11-09');

// ✅ Comparison methods
date1.isBefore(date2);                  // true
date1.isAfter(date2);                   // false
date1.isSame(date2, 'day');             // false
date1.isBetween(start, end);            // boolean

// ✅ Difference
date2.diff(date1, 'day');               // 1
date2.diff(date1, 'hour');              // 24
```

### Timezone Handling

```tsx
import dayjs from 'dayjs';
import utc from 'dayjs/plugin/utc';
import timezone from 'dayjs/plugin/timezone';

dayjs.extend(utc);
dayjs.extend(timezone);

// ✅ Convert to UTC
const utcDate = dayjs(date).utc();
const utcString = dayjs(date).utc().format();

// ✅ Convert to specific timezone
const nyTime = dayjs(date).tz('America/New_York');
const tokyoTime = dayjs(date).tz('Asia/Tokyo');

// ✅ Get local time from UTC
const localTime = dayjs.utc(utcString).local();
```

## Usage with Material-UI Date Pickers

**MUI DatePicker already uses Day.js as adapter:**

```tsx
import { DatePicker } from '@mui/x-date-pickers/DatePicker';
import { LocalizationProvider } from '@mui/x-date-pickers/LocalizationProvider';
import { AdapterDayjs } from '@mui/x-date-pickers/AdapterDayjs';
import dayjs, { Dayjs } from 'dayjs';

function MyComponent() {
  const [date, setDate] = useState<Dayjs | null>(dayjs());

  return (
    <LocalizationProvider dateAdapter={AdapterDayjs}>
      <DatePicker
        label="Select Date"
        value={date}
        onChange={(newValue) => setDate(newValue)}
        format="MM/DD/YYYY"
      />
    </LocalizationProvider>
  );
}
```

## Common Use Cases

### Display "expires in" or "expires at":

```tsx
// ❌ WRONG
import { formatDistanceToNow } from 'date-fns';

<TableCell>
  {formatDistanceToNow(new Date(invitation.expiresAt), { addSuffix: true })}
</TableCell>

// ✅ CORRECT
import dayjs from 'dayjs';
import relativeTime from 'dayjs/plugin/relativeTime';
dayjs.extend(relativeTime);

<TableCell>
  {dayjs(invitation.expiresAt).fromNow()}
</TableCell>
```

### Format for display:

```tsx
import dayjs from 'dayjs';

// User-friendly date
<Typography>{dayjs(createdAt).format('MMM DD, YYYY')}</Typography>

// Date with time
<Typography>{dayjs(createdAt).format('MMM DD, YYYY h:mm A')}</Typography>

// Relative time with fallback
<Typography>
  {dayjs(createdAt).fromNow()} ({dayjs(createdAt).format('MMM DD, YYYY')})
</Typography>
```

### Validate date range:

```tsx
const isExpired = dayjs().isAfter(expiresAt);
const isValid = dayjs(date).isBetween(startDate, endDate, null, '[]'); // inclusive
```

### Convert API date to local:

```tsx
import dayjs from 'dayjs';
import utc from 'dayjs/plugin/utc';
dayjs.extend(utc);

// API returns UTC timestamp
const apiDate = '2024-11-08T15:30:00Z';

// Convert to local timezone for display
const localDate = dayjs.utc(apiDate).local();
const formatted = localDate.format('MMM DD, YYYY h:mm A');
```

## Migration from date-fns to Day.js

| date-fns | Day.js Equivalent |
|----------|------------------|
| `format(date, 'MM/dd/yyyy')` | `dayjs(date).format('MM/DD/YYYY')` |
| `formatDistanceToNow(date, { addSuffix: true })` | `dayjs(date).fromNow()` |
| `addDays(date, 7)` | `dayjs(date).add(7, 'day')` |
| `subMonths(date, 1)` | `dayjs(date).subtract(1, 'month')` |
| `startOfMonth(date)` | `dayjs(date).startOf('month')` |
| `isAfter(date1, date2)` | `dayjs(date1).isAfter(date2)` |
| `isBefore(date1, date2)` | `dayjs(date1).isBefore(date2)` |
| `differenceInDays(date1, date2)` | `dayjs(date1).diff(date2, 'day')` |
| `parseISO(string)` | `dayjs(string)` |

## Utility Function Pattern

**Create a utility file for common date operations:**

```tsx
// apps/front/app/utils/format-time.ts
import dayjs from 'dayjs';
import relativeTime from 'dayjs/plugin/relativeTime';
import utc from 'dayjs/plugin/utc';

dayjs.extend(relativeTime);
dayjs.extend(utc);

export function formatDate(date: string | Date, format = 'MMM DD, YYYY'): string {
  return dayjs(date).format(format);
}

export function formatRelativeTime(date: string | Date): string {
  return dayjs(date).fromNow();
}

export function formatDateTime(date: string | Date): string {
  return dayjs(date).format('MMM DD, YYYY h:mm A');
}

export function isExpired(date: string | Date): boolean {
  return dayjs().isAfter(dayjs(date));
}
```

**Usage:**
```tsx
import { formatDate, formatRelativeTime } from '~/utils/format-time';

<Typography>{formatDate(invitation.createdAt)}</Typography>
<Typography>{formatRelativeTime(invitation.expiresAt)}</Typography>
```

## Rules to Remember

1. ✅ **Always use Day.js** for date operations
2. ✅ **Import required plugins** (relativeTime, utc, timezone)
3. ✅ **Use `fromNow()`** instead of formatDistanceToNow
4. ✅ **Use consistent format patterns** across the app
5. ❌ **Never use date-fns**
6. ❌ **Never use Moment.js** (deprecated, too large)
7. ❌ **Avoid native Date formatting** (use Day.js instead)
8. ✅ **Check existing `utils/format-time.ts`** for utility functions

