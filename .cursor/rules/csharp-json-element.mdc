# C# JsonElement in Request Bodies

## ALWAYS use JsonElement for request body properties

**CRITICAL RULE:** Request body DTOs MUST use `JsonElement` for ALL properties to allow FluentValidation filters to run.

## Why JsonElement?

ASP.NET Core parameter binding runs BEFORE FluentValidation filters:

1. **Without JsonElement**: Invalid data throws exception before validation
2. **With JsonElement**: Validation can provide friendly error messages

```csharp
// ❌ WRONG - Binding fails before validation runs
public record CreateUserBody {
    public required string Email { get; init; }  // Throws if not a string
    public required Guid Id { get; init; }       // Throws if invalid GUID format
    public required int Age { get; init; }       // Throws if not a number
}
// Problem: User sends {"Id": "not-a-guid"} → 400 Bad Request with ugly error

// ✅ CORRECT - Validation handles conversion
public record CreateUserBody {
    public required JsonElement Email { get; init; }
    public required JsonElement Id { get; init; }
    public required JsonElement Age { get; init; }
}
// Solution: Validation provides: "Id must be a valid GUID"
```

## Request Body Pattern

```csharp
using System.Text.Json;
using FluentValidation;

// ✅ CORRECT - All properties are JsonElement
public record CreateStaffInvitationBody {
    public required JsonElement Email { get; init; }
    public required JsonElement ProfileId { get; init; }
}

// Validator extracts and validates
public class CreateStaffInvitationBodyValidator : AbstractValidator<CreateStaffInvitationBody> {
    public CreateStaffInvitationBodyValidator() {
        RuleFor(x => x.Email)
            .Must(BeValidJsonString).WithMessage("Email must be a string")
            .Must(BeValidEmail).WithMessage("Invalid email format");

        RuleFor(x => x.ProfileId)
            .Must(BeValidGuid).WithMessage("ProfileId must be a valid GUID");
    }

    private bool BeValidJsonString(JsonElement element) {
        return element.ValueKind == JsonValueKind.String;
    }

    private bool BeValidEmail(JsonElement element) {
        if (element.ValueKind != JsonValueKind.String) return false;
        var email = element.GetString();
        return !string.IsNullOrEmpty(email) && email.Contains('@');
    }

    private bool BeValidGuid(JsonElement element) {
        if (element.ValueKind != JsonValueKind.String) return false;
        return Guid.TryParse(element.GetString(), out _);
    }
}

// Handler extracts values
public static class CreateStaffInvitation {
    public static async Task<Results<Ok, BadRequest>> HandleCreateStaffInvitation(
        [FromBody] CreateStaffInvitationBody request,
        [FromServices] IInvitationService invitationService,
        CancellationToken cancellationToken
    ) {
        // Extract after validation passes
        var email = request.Email.GetString()!;
        var profileId = Guid.Parse(request.ProfileId.GetString()!);

        var result = await invitationService.CreateAsync(email, profileId, cancellationToken);
        return TypedResults.Ok();
    }
}
```

## Query Parameters: DO NOT use JsonElement

Query parameters come from URLs (always strings), so JsonElement is NOT needed:

```csharp
// ✅ CORRECT - Query params use typed properties
public record ListInvitationsQuery {
    public string? Email { get; init; }
    public InvitationScope? Scope { get; init; }
    public int? Page { get; init; }
    public int? PageSize { get; init; }
}

// Validator for query params
public class ListInvitationsQueryValidator : AbstractValidator<ListInvitationsQuery> {
    public ListInvitationsQueryValidator() {
        RuleFor(x => x.Email)
            .EmailAddress()
            .When(x => !string.IsNullOrEmpty(x.Email));

        RuleFor(x => x.Page)
            .GreaterThanOrEqualTo(1)
            .When(x => x.Page.HasValue);

        RuleFor(x => x.PageSize)
            .InclusiveBetween(1, 100)
            .When(x => x.PageSize.HasValue);
    }
}
```

## Route Parameters: DO NOT use JsonElement

Route parameters are strings/guids from URLs:

```csharp
// ✅ CORRECT - Route params are typed directly
public static async Task<Results<Ok, NotFound>> HandleGetInvitation(
    [FromRoute] Guid invitationId,  // ✅ Guid from route
    [FromRoute] string token,        // ✅ String from route
    [FromServices] IInvitationService invitationService,
    CancellationToken cancellationToken
) {
    // Use directly
    var invitation = await invitationService.GetByIdAsync(invitationId, cancellationToken);
    return invitation is not null ? TypedResults.Ok() : TypedResults.NotFound();
}
```

## Common JsonElement Operations

```csharp
// Get string
var email = request.Email.GetString()!;

// Get GUID
var id = Guid.Parse(request.Id.GetString()!);

// Get int
var age = request.Age.GetInt32();

// Get bool
var isActive = request.IsActive.GetBoolean();

// Get nullable values
var optionalName = request.Name.ValueKind == JsonValueKind.Null
    ? null
    : request.Name.GetString();

// Get array
if (request.Tags.ValueKind == JsonValueKind.Array) {
    var tags = request.Tags.EnumerateArray()
        .Select(e => e.GetString()!)
        .ToList();
}

// Get object property
if (request.Metadata.ValueKind == JsonValueKind.Object) {
    if (request.Metadata.TryGetProperty("key", out var keyElement)) {
        var value = keyElement.GetString();
    }
}
```

## Helper Extension Methods (Optional)

Create extensions for common patterns:

```csharp
public static class JsonElementExtensions {
    public static Guid GetRequiredGuid(this JsonElement element, string propertyName) {
        if (element.ValueKind != JsonValueKind.String) {
            throw new ValidationException($"{propertyName} must be a string");
        }

        if (!Guid.TryParse(element.GetString(), out var guid)) {
            throw new ValidationException($"{propertyName} must be a valid GUID");
        }

        return guid;
    }

    public static string GetRequiredString(this JsonElement element, string propertyName) {
        if (element.ValueKind != JsonValueKind.String) {
            throw new ValidationException($"{propertyName} must be a string");
        }

        var value = element.GetString();
        if (string.IsNullOrWhiteSpace(value)) {
            throw new ValidationException($"{propertyName} cannot be empty");
        }

        return value;
    }
}

// Usage
var email = request.Email.GetRequiredString("Email");
var profileId = request.ProfileId.GetRequiredGuid("ProfileId");
```

## Rules Summary

1. **Request bodies**: ALWAYS use JsonElement for all properties
2. **Query parameters**: Use typed properties (string, int, enum)
3. **Route parameters**: Use typed parameters (Guid, string, int)
4. **Validators**: Extract and validate JsonElement in FluentValidation
5. **Handlers**: Extract values after validation passes
6. **Error messages**: Provide friendly validation errors

## Complete Example

```csharp
// Request body DTO - JsonElement properties
public record UpdateTenantBody {
    public required JsonElement Name { get; init; }
    public required JsonElement Status { get; init; }
    public required JsonElement MaxUsers { get; init; }
}

// Validator
public class UpdateTenantBodyValidator : AbstractValidator<UpdateTenantBody> {
    public UpdateTenantBodyValidator() {
        RuleFor(x => x.Name)
            .Must(e => e.ValueKind == JsonValueKind.String)
            .WithMessage("Name must be a string")
            .Must(e => !string.IsNullOrWhiteSpace(e.GetString()))
            .WithMessage("Name cannot be empty");

        RuleFor(x => x.Status)
            .Must(e => e.ValueKind == JsonValueKind.String)
            .WithMessage("Status must be a string")
            .Must(BeValidStatus)
            .WithMessage("Status must be 'Active' or 'Suspended'");

        RuleFor(x => x.MaxUsers)
            .Must(e => e.ValueKind == JsonValueKind.Number)
            .WithMessage("MaxUsers must be a number")
            .Must(e => e.GetInt32() > 0)
            .WithMessage("MaxUsers must be greater than 0");
    }

    private bool BeValidStatus(JsonElement element) {
        var status = element.GetString();
        return status == "Active" || status == "Suspended";
    }
}

// Handler
public static class UpdateTenant {
    public static async Task<Results<Ok, BadRequest<ApiResponse>, NotFound>> HandleUpdateTenant(
        [FromRoute] Guid tenantId,
        [FromBody] UpdateTenantBody request,
        [FromServices] ITenantService tenantService,
        CancellationToken cancellationToken
    ) {
        // Extract after validation
        var name = request.Name.GetString()!;
        var status = Enum.Parse<TenantStatus>(request.Status.GetString()!);
        var maxUsers = request.MaxUsers.GetInt32();

        var result = await tenantService.UpdateAsync(
            tenantId,
            name,
            status,
            maxUsers,
            cancellationToken
        );

        return result ? TypedResults.Ok() : TypedResults.NotFound();
    }
}
```
