# PublyApp environment template.
#
# Copy this file to `.env.development` for local development. It is gitignored
# and MUST NOT be committed. Deployed environments receive their configuration
# from the active PaaS configuration/secrets service (Dokploy today), never
# from an application-loaded `.env` file. Configuration is read exclusively via
# AppEnvironment (apps/api/Lib/AppEnvironment.cs) and validated at startup.
#
# Lines marked "# SECRET" hold credentials — set them locally / in your
# deployment secret store, never commit a real value, and never inline a `#`
# in a Dokploy secret value (a `#` silently truncates it).

# --- App / URLs ---
APP_NAME="PublyApp"
FRONT_URL="http://localhost:5050"
PUBLIC_API_BASE_URL="http://localhost:5000"

# Public origin of the deployed frontend (scheme + host, no trailing path).
# REQUIRED when NODE_ENV=production (#1731): without it the front refuses to
# start rather than deriving SEO canonical/Open Graph URLs from the
# client-supplied Host header, which a client can forge. Optional in
# development and test, where falling back to the request host is legitimate
# and logs a warning.
# Dokploy note: a `#` truncates the value silently — never put one in it.
PUBLIC_ORIGIN=https://app.example.com
SERVER_API_BASE_URL="http://localhost:5000"
VITE_ASP_SERVER_URL="http://localhost:5000"

# --- Database ---
# Aspire AppHost default (port 5454, persistent data volume). Do not use this value
# in a deployed environment.
POSTGRES_CONNECTION_STRING="Host=localhost;Port=5454;Database=publyapp_db;Username=postgres;Password=password"

# --- Email (Resend) ---
# SECRET: Resend API key.
RESEND_API_KEY="CHANGE_ME"
DEFAULT_EMAIL_SENDER_NAME="PublyApp Support"
DEFAULT_EMAIL_SENDER_EMAIL="no-reply@example.com"

# --- Staff owner bootstrap ---
STAFF_OWNER_EMAIL="owner@example.com"
# SECRET: one-time bootstrap code used to seed the platform owner.
STAFF_OWNER_BOOTSTRAP_CODE="CHANGE_ME"

# --- Social accounts credential encryption master key (Epic C §4) ---
# Placeholder — DO NOT use in production. Generate a real one:
# openssl rand -base64 32  (32 bytes). Override in Dokploy for api, worker,
# and migrate (see docs/deployment). Required in every role incl. Testing.
SOCIAL_ACCOUNTS_MASTER_KEY="NmPlOY4IXMIqksyOOpwMmo0oZGHr3gIrqpMP/eKHVkY="

# --- Auth / sessions / tokens ---
SESSION_TOKEN_HEADER_KEY="X-Session-Token"
TENANT_ID_HEADER_KEY="X-PublyApp-TenantId"
SESSION_EXPIRY_DAYS="7"
PASSWORD_MIN_LENGTH="12"
EMAIL_VERIFY_TOKEN_LENGTH="25"
EMAIL_VERIFY_TOKEN_VALIDITY_DURATION="7"
PASSWORD_RESET_TOKEN_LENGTH="25"
PASSWORD_RESET_TOKEN_VALIDITY_DURATION="7"
INVITATION_TOKEN_LENGTH="32"

# --- Reverse proxy trust ---
# Development/Testing safely trust loopback only. Production API processes MUST
# replace this with Traefik's exact /32 or /128 address(es), or a CIDR for a dedicated
# proxy network joined only by Traefik and the API. Never trust the shared
# dokploy-network subnet, 0.0.0.0/0, or ::/0: peer containers could then forge
# X-Forwarded-For and evade limits.
TRUSTED_PROXY_CIDRS="127.0.0.1/32,::1/128"

# --- Anonymous auth rate limits ---
# Fixed-window limits. Per-IP applies to all anonymous auth writes. The general
# per-email limit covers login/register; the stricter email limit covers
# password-reset and verification-email requests.
ANON_AUTH_IP_RATE_LIMIT_PERMIT_LIMIT="30"
ANON_AUTH_IP_RATE_LIMIT_WINDOW_SECONDS="60"
ANON_AUTH_EMAIL_RATE_LIMIT_PERMIT_LIMIT="30"
ANON_AUTH_EMAIL_RATE_LIMIT_WINDOW_SECONDS="60"
PASSWORD_RESET_EMAIL_RATE_LIMIT_PERMIT_LIMIT="3"
PASSWORD_RESET_EMAIL_RATE_LIMIT_WINDOW_SECONDS="900"

# --- Comprehensive API rate limits ---
# Fixed-window limits. Authenticated partitions use a validated session-ID fingerprint;
# tenant variants chain the session limit with a tenant-wide limit.
GLOBAL_RATE_LIMIT_PERMIT_LIMIT="6000"
GLOBAL_RATE_LIMIT_WINDOW_SECONDS="60"
ANONYMOUS_OTHER_RATE_LIMIT_PERMIT_LIMIT="120"
ANONYMOUS_OTHER_RATE_LIMIT_WINDOW_SECONDS="60"
AUTHENTICATED_RATE_LIMIT_PERMIT_LIMIT="600"
AUTHENTICATED_RATE_LIMIT_WINDOW_SECONDS="60"
HEAVY_SEARCH_RATE_LIMIT_PERMIT_LIMIT="180"
HEAVY_SEARCH_RATE_LIMIT_WINDOW_SECONDS="60"
BULK_RATE_LIMIT_PERMIT_LIMIT="30"
BULK_RATE_LIMIT_WINDOW_SECONDS="60"
TENANT_BULK_RATE_LIMIT_PERMIT_LIMIT="120"
TENANT_BULK_RATE_LIMIT_WINDOW_SECONDS="60"
EMAIL_RATE_LIMIT_PERMIT_LIMIT="10"
EMAIL_RATE_LIMIT_WINDOW_SECONDS="900"
TENANT_EMAIL_RATE_LIMIT_PERMIT_LIMIT="50"
TENANT_EMAIL_RATE_LIMIT_WINDOW_SECONDS="900"
EXPORT_RATE_LIMIT_PERMIT_LIMIT="10"
EXPORT_RATE_LIMIT_WINDOW_SECONDS="60"
TENANT_EXPORT_RATE_LIMIT_PERMIT_LIMIT="40"
TENANT_EXPORT_RATE_LIMIT_WINDOW_SECONDS="60"
UPLOAD_RATE_LIMIT_PERMIT_LIMIT="20"
UPLOAD_RATE_LIMIT_WINDOW_SECONDS="60"
SOCIAL_CONNECT_RATE_LIMIT_PERMIT_LIMIT="5"
SOCIAL_CONNECT_RATE_LIMIT_WINDOW_SECONDS="3600"
# A5 (#636): staff system-job trigger-now (a real job_queue enqueue per request)
SYSTEM_JOB_TRIGGER_RATE_LIMIT_PERMIT_LIMIT="30"
SYSTEM_JOB_TRIGGER_RATE_LIMIT_WINDOW_SECONDS="60"

# --- Rate-limit counter store (#953) ---
# Where fixed-window counters live. "postgres" (default) makes every replica share
# one fleet-wide budget per partition via an atomic conditional UPSERT; "memory"
# restores per-process counting (pre-#953) for incident triage on a single replica.
RATE_LIMIT_COUNTER_STORE="postgres"

# --- Domain limits ---
MAX_PROFILES_PER_USER="5"
UPLOAD_MAX_BYTES="2000000"
# In-process phase-1 upload admission budgets. The global budget is 1 GiB and
# each staff user may account for at most 100 MiB of successful/in-flight uploads
# per API process. Phase 2 of #807 will replace these process-local counters with
# durable asset accounting shared across replicas.
UPLOAD_GLOBAL_MAX_BYTES="1073741824"
UPLOAD_PER_STAFF_MAX_BYTES="104857600"
# Days an orphaned upload (no references left) must age past before the sweeper
# job may physically delete its blob. Deferred deletion always rechecks the
# reference count at delete time, so this is a grace window, not a race.
UPLOAD_ORPHAN_GRACE_DAYS="7"
# Minutes after which a Reserved upload-asset row is considered abandoned by a
# crashed writer; the sweeper then deletes the row and releases its held bytes.
UPLOAD_STALE_RESERVATION_TTL_MINUTES="60"
# Minutes after which an unreferenced Stored upload (the fail-soft "blob MAY
# exist" path) may be reclaimed by the sweeper: blob removed, bytes released.
UPLOAD_STORED_ORPHAN_TTL_MINUTES="1440"
TENANT_USER_EXPORT_MAX_ROWS="10000"
AUDIT_LOG_EXPORT_MAX_ROWS="10000"
TENANT_ACTIVITY_THROTTLE_MINUTES="5"

# --- Storage ---
FILE_STORAGE_ROOT=".artifacts/storage"

# --- Misc ---
DI_MANIFEST_ENABLED="false"

# --- Hosting role (APP_ROLE) ---
# Which composition root this process runs: "api" (HTTP surface only), "worker"
# (job engine only), or "all" (both). Optional ONLY in Development/Testing, where
# it defaults to "all" (so local dev runs the API and the job engine in one
# process). REQUIRED in Production/Staging — a missing/blank value fails fast at
# startup, because "all" composing the job engine must never be inherited by
# omission. The Dokploy deployment pins it PER-SERVICE in dokploy.yml
# (publyapp-api=api, publyapp-worker=worker, publyapp-migrate=api), so it is NOT
# a Dokploy dashboard variable — this entry is for the local .env.development.
APP_ROLE="all"

# --- Background jobs / worker engine tuning ---
# All optional; shown with their AppEnvironment code defaults. These are queue
# processor + retention-sweep knobs — omit any line to accept the default. Days
# unless the name says minutes/seconds.
JOB_QUEUE_BATCH_SIZE="20"
JOB_QUEUE_POLL_SECONDS="5"
JOB_LEASE_SECONDS="300"
JOB_QUEUE_DRAIN_BUDGET_SECONDS="60"
EMAIL_LOG_RETENTION_DAYS="180"
JOB_DEAD_LETTER_RETENTION_DAYS="90"
EMAIL_PREPARED_SEND_RETENTION_DAYS="7"
EMAIL_PREPARED_SWEEP_MAX_LAG_MINUTES="60"
SYSTEM_JOB_OCCURRENCE_RETENTION_DAYS="30"
JOB_ALERT_LEASE_RETENTION_DAYS="30"
# Exact job_type strings tolerated as historical DLQ orphans (comma-separated).
# Empty by default; wildcards are rejected at startup.
JOB_REGISTRY_DLQ_ORPHAN_ALLOWLIST=""

# --- Frontend analytics (PostHog) ---
# Client-exposed project key. Set per environment.
PUBLIC_POSTHOG_PROJECT_TOKEN="CHANGE_ME"
