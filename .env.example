# PublyApp environment template.
#
# Copy this file to `.env.development` (local dev) or `.env.production` (deploy)
# and fill in the real values. Those files are gitignored and MUST NOT be
# committed. Configuration is read exclusively via AppEnvironment
# (apps/api/Lib/AppEnvironment.cs) and validated at startup.
#
# Lines marked "# SECRET" hold credentials — set them locally / in your
# deployment secret store, never commit a real value, and never inline a `#`
# in a Dokploy secret value (a `#` silently truncates it).

# --- App / URLs ---
APP_NAME=PublyApp
FRONT_URL=http://localhost:5050
PUBLIC_API_BASE_URL=http://localhost:5000
SERVER_API_BASE_URL=http://localhost:5000
VITE_ASP_SERVER_URL=http://localhost:5000

# --- Database ---
# SECRET: contains the DB password. Dev default targets the local docker Postgres (localhost:5454).
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5454;Database=publyapp;Username=postgres;Password=CHANGE_ME

# --- Email (Resend) ---
# SECRET: Resend API key.
RESEND_API_KEY=CHANGE_ME
DEFAULT_EMAIL_SENDER_NAME="PublyApp Support"
DEFAULT_EMAIL_SENDER_EMAIL=no-reply@example.com

# --- Staff owner bootstrap ---
STAFF_OWNER_EMAIL=owner@example.com
# SECRET: one-time bootstrap code used to seed the platform owner.
STAFF_OWNER_BOOTSTRAP_CODE=CHANGE_ME

# --- Auth / sessions / tokens ---
SESSION_TOKEN_HEADER_KEY=X-Session-Token
TENANT_ID_HEADER_KEY=X-PublyApp-TenantId
SESSION_EXPIRY_DAYS=7
PASSWORD_MIN_LENGTH=12
EMAIL_VERIFY_TOKEN_LENGTH=25
EMAIL_VERIFY_TOKEN_VALIDITY_DURATION=7
PASSWORD_RESET_TOKEN_LENGTH=25
PASSWORD_RESET_TOKEN_VALIDITY_DURATION=7
INVITATION_TOKEN_LENGTH=32

# --- Domain limits ---
MAX_PROFILES_PER_USER=5
UPLOAD_MAX_BYTES=2000000
TENANT_USER_EXPORT_MAX_ROWS=10000
TENANT_ACTIVITY_THROTTLE_MINUTES=5

# --- Storage ---
FILE_STORAGE_ROOT=.artifacts/storage

# --- Misc ---
DI_MANIFEST_ENABLED=false

# --- Frontend analytics (PostHog) ---
# Client-exposed (VITE_) project key. Set per environment.
VITE_POSTHOG_PROJECT_TOKEN=CHANGE_ME
PUBLIC_POSTHOG_PROJECT_TOKEN=CHANGE_ME
