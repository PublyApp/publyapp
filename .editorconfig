# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
indent_style = tab
tab_width = 2
indent_size = 2
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space

# C# files
[*.cs]

# ==== Formatter style (Js/Java-style braces) ====
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false

# ==== Expression-body preferences (block-bodied members) ====
# Block-bodied methods, operators, and accessors (no expression-body shorthand)
csharp_style_expression_bodied_methods = false:warning
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_operators = false:warning
csharp_style_expression_bodied_properties = false:warning
csharp_style_expression_bodied_indexers = false:warning
csharp_style_expression_bodied_accessors = false:warning
csharp_style_expression_bodied_local_functions = false:warning

# ==== Using-directive organization ====
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
csharp_using_directive_placement = outside_namespace:warning

# ==== Promoted to warning (rules we ENFORCE) ====
dotnet_diagnostic.IDE0004.severity = warning   # Remove unnecessary cast
dotnet_diagnostic.IDE0005.severity = warning   # Unused using directive
dotnet_diagnostic.IDE0010.severity = warning   # Populate switch statement
dotnet_diagnostic.IDE0011.severity = warning   # Add braces to single-line statements
dotnet_diagnostic.IDE0021.severity = warning   # Use block body for constructors
dotnet_diagnostic.IDE0022.severity = warning   # Use block body for methods
dotnet_diagnostic.IDE0023.severity = warning   # Use block body for conversion operators
dotnet_diagnostic.IDE0024.severity = warning   # Use block body for operators
dotnet_diagnostic.IDE0025.severity = warning   # Use block body for properties
dotnet_diagnostic.IDE0026.severity = warning   # Use block body for indexers
dotnet_diagnostic.IDE0027.severity = warning   # Use block body for accessors
dotnet_diagnostic.IDE0036.severity = warning   # Order modifiers
dotnet_diagnostic.IDE0051.severity = warning   # Remove unread private members
dotnet_diagnostic.IDE0052.severity = warning   # Remove unread private members (fields)
dotnet_diagnostic.IDE0059.severity = warning   # Unnecessary assignment of a value
dotnet_diagnostic.IDE0060.severity = warning   # Remove unused parameter
dotnet_diagnostic.IDE0065.severity = warning   # Using directives must be placed outside the namespace
dotnet_diagnostic.IDE0072.severity = warning   # Populate switch expression
dotnet_diagnostic.IDE0130.severity = warning   # Namespace does not match folder structure
dotnet_diagnostic.IDE0300.severity = warning   # Use collection initializers
dotnet_diagnostic.IDE2000.severity = warning   # Avoid multiple blank lines
dotnet_diagnostic.CA1304.severity = warning    # Specify CultureInfo for string ops
dotnet_diagnostic.CA1305.severity = warning    # Specify IFormatProvider for formatting
dotnet_diagnostic.CA1310.severity = warning    # Specify StringComparison for string ops
dotnet_diagnostic.CA1311.severity = warning    # Specify culture or use invariant ToUpper/ToLower
dotnet_diagnostic.CA1507.severity = warning    # Use nameof in place of string
dotnet_diagnostic.CA1822.severity = warning    # Mark members as static when they don't use instance data
dotnet_diagnostic.CA1725.severity = warning    # Parameter names should match base method declaration
dotnet_diagnostic.CA1825.severity = warning    # Avoid zero-length array allocations (use Array.Empty<T>)
dotnet_diagnostic.CA1827.severity = warning    # Use .Any() instead of .Count() > 0
dotnet_diagnostic.CA1860.severity = warning    # Avoid using 'Enumerable.Any()' extension method
dotnet_diagnostic.CA1861.severity = warning    # Prefer static readonly fields over constant array arguments
dotnet_diagnostic.CA1862.severity = warning    # Use StringComparison method overloads (case-insensitive)
dotnet_diagnostic.CA1869.severity = warning    # Cache and reuse JsonSerializerOptions instances
dotnet_diagnostic.CA1873.severity = warning    # Avoid potentially expensive method calls as arguments
dotnet_diagnostic.CA2201.severity = warning    # Do not raise reserved exception types
dotnet_diagnostic.CA2251.severity = warning    # Use string.Equals overload instead of string.Compare
dotnet_diagnostic.CS0168.severity = warning    # Variable declared but never used
dotnet_diagnostic.CS0219.severity = warning    # Variable assigned but value never used
dotnet_diagnostic.SYSLIB1045.severity = warning # Use [GeneratedRegex]
dotnet_diagnostic.xUnit1042.severity = warning  # MemberData should return TheoryData<...> for type safety

# ==== Suppressed (severity = none — noise we don't enforce) ====
dotnet_diagnostic.IDE0001.severity = none      # Simplify names
dotnet_diagnostic.IDE0008.severity = none      # Use explicit type instead of 'var'
dotnet_diagnostic.IDE0028.severity = none      # Simplify collection initialization
dotnet_diagnostic.IDE0030.severity = none      # Null check can be simplified
dotnet_diagnostic.IDE0037.severity = none      # Member name can be simplified
dotnet_diagnostic.IDE0042.severity = none      # Deconstruct variable declaration
dotnet_diagnostic.IDE0046.severity = none      # 'if' statement can be simplified
dotnet_diagnostic.IDE0058.severity = none      # Expression value is never used
dotnet_diagnostic.IDE0074.severity = none      # Use compound assignment
dotnet_diagnostic.IDE0075.severity = none      # Simplify conditional expression
dotnet_diagnostic.IDE0090.severity = none      # Use 'new(…)'
dotnet_diagnostic.IDE0160.severity = none      # Convert to block scoped namespace
dotnet_diagnostic.IDE0200.severity = none      # Remove unnecessary lambda expression
dotnet_diagnostic.IDE0270.severity = none      # Null check can be simplified (use ??)
dotnet_diagnostic.IDE0290.severity = none      # Use primary constructor
dotnet_diagnostic.IDE0305.severity = none      # Simplify collection initialization
dotnet_diagnostic.CA1000.severity = none       # Do not declare static members on generic types
dotnet_diagnostic.CA1707.severity = none       # Identifiers should not contain underscores
dotnet_diagnostic.CA1711.severity = none       # Identifiers should not have incorrect suffix
dotnet_diagnostic.CA1848.severity = none       # Use the LoggerMessage delegates
dotnet_diagnostic.CS1591.severity = none       # Missing XML comment for publicly visible type or member

# ==== Per-file overrides ====

# EF Core Migrations - auto-generated code
[**/Migrations/*.cs]
# Disable unnecessary using directive check for generated migrations
dotnet_diagnostic.IDE0005.severity = none
# Generated migrations emit `new[] { ... }` arrays; do not auto-rewrite them
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.CA1861.severity = none   # Migrations use new[] {} for column lists; don't auto-rewrite

# Test code overrides
[**/Tests/**/*.cs]
# Test infrastructure (response DTOs, fixtures, fakes) does not benefit from sealing
dotnet_diagnostic.CA1852.severity = none
