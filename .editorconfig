# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
indent_style = tab
tab_width = 2
indent_size = 2
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space

# C# files
[*.cs]

# ==== Formatter style (Js/Java-style braces) ====
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false

# ==== Using-directive organization ====
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# ==== Promoted to warning (rules we ENFORCE) ====
dotnet_diagnostic.IDE0005.severity = warning   # Unused using directive
dotnet_diagnostic.IDE0059.severity = warning   # Unnecessary assignment of a value
dotnet_diagnostic.IDE0060.severity = warning   # Remove unused parameter
dotnet_diagnostic.IDE0130.severity = warning   # Namespace does not match folder structure
dotnet_diagnostic.IDE0300.severity = warning   # Use collection initializers
dotnet_diagnostic.IDE2000.severity = warning   # Avoid multiple blank lines
dotnet_diagnostic.CA1507.severity = warning    # Use nameof in place of string
dotnet_diagnostic.CA1860.severity = warning    # Avoid using 'Enumerable.Any()' extension method
dotnet_diagnostic.CA1873.severity = warning    # Avoid potentially expensive method calls as arguments
dotnet_diagnostic.CS0168.severity = warning    # Variable declared but never used
dotnet_diagnostic.CS0219.severity = warning    # Variable assigned but value never used

# ==== Suppressed (severity = none — noise we don't enforce) ====
dotnet_diagnostic.IDE0001.severity = none      # Simplify names
dotnet_diagnostic.IDE0028.severity = none      # Simplify collection initialization
dotnet_diagnostic.IDE0030.severity = none      # Null check can be simplified
dotnet_diagnostic.IDE0037.severity = none      # Member name can be simplified
dotnet_diagnostic.IDE0042.severity = none      # Deconstruct variable declaration
dotnet_diagnostic.IDE0074.severity = none      # Use compound assignment
dotnet_diagnostic.IDE0075.severity = none      # Simplify conditional expression
dotnet_diagnostic.IDE0090.severity = none      # Use 'new(…)'
dotnet_diagnostic.IDE0160.severity = none      # Convert to block scoped namespace
dotnet_diagnostic.IDE0200.severity = none      # Remove unnecessary lambda expression
dotnet_diagnostic.IDE0270.severity = none      # Null check can be simplified (use ??)
dotnet_diagnostic.IDE0290.severity = none      # Use primary constructor
dotnet_diagnostic.IDE0305.severity = none      # Simplify collection initialization
dotnet_diagnostic.CA1000.severity = none       # Do not declare static members on generic types
dotnet_diagnostic.CA1707.severity = none       # Identifiers should not contain underscores
dotnet_diagnostic.CA1711.severity = none       # Identifiers should not have incorrect suffix
dotnet_diagnostic.CA1848.severity = none       # Use the LoggerMessage delegates
dotnet_diagnostic.CS1591.severity = none       # Missing XML comment for publicly visible type or member

# ==== Per-file overrides ====

# EF Core Migrations - auto-generated code
[**/Migrations/*.cs]
# Disable unnecessary using directive check for generated migrations
dotnet_diagnostic.IDE0005.severity = none
# Generated migrations emit `new[] { ... }` arrays; do not auto-rewrite them
dotnet_diagnostic.IDE0300.severity = none
